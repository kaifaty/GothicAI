+#pragma once
+
+#include "gapi/shaderreflection.h"
+#include <bit>
+
+namespace Tempest::Detail {
+inline ShaderReflection::LayoutDesc descriptorPart(ShaderReflection::LayoutDesc layout, uint32_t active) {
+  layout.active &= active;
+  layout.array &= active;
+  layout.runtime &= active;
+  layout.resources &= active;
+  layout.samplers &= active;
+  for(size_t i=0; i<MaxBindings; ++i) {
+    if(layout.active & (1u<<i))
+      continue;
+    layout.bindings[i] = ShaderReflection::Count;
+    layout.stage[i] = ShaderReflection::None;
+    layout.count[i] = layout.bufferSz[i] = layout.bufferEl[i] = 0;
+    }
+  return layout;
+  }
+}
