diff --git a/OpenGothic/shader/ssao/ssao_depth.comp b/OpenGothic/shader/ssao/ssao_depth.comp
new file mode 100644
--- /dev/null
+++ b/OpenGothic/shader/ssao/ssao_depth.comp
@@ -0,0 +1,25 @@
+#version 460
+#extension GL_ARB_separate_shader_objects : enable
+#extension GL_GOOGLE_include_directive : enable
+#extension GL_EXT_control_flow_attributes : enable
+
+// The depth buffer laid out as a 4x4 atlas for ssao.comp: tile (a,b) holds the pixels x%4==a, y%4==b. Threads of
+// one SIMD group trace texels four depth pixels apart; in the atlas their samples read neighbouring texels.
+// One thread moves one 4x4 block, so both the reads and the writes of neighbouring threads are neighbours.
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(binding = 0) uniform writeonly image2D result;
+layout(binding = 1) uniform sampler2D depthBuf;
+
+void main() {
+  const ivec2 size = textureSize(depthBuf, 0);
+  const ivec2 tile = (size + 3)/4;
+  const ivec2 at   = ivec2(gl_GlobalInvocationID.xy);
+  if(any(greaterThanEqual(at, tile)))
+    return;
+  [[unroll]] for(int b=0; b<4; ++b)
+    [[unroll]] for(int a=0; a<4; ++a) {
+      const ivec2 src = min(at*4 + ivec2(a,b), size-1);
+      imageStore(result, ivec2(a,b)*tile + at, vec4(texelFetch(depthBuf, src, 0).r));
+      }
+  }
