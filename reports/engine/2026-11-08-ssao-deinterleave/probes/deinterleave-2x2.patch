+// Deinterleaved sampling (reports/engine/2026-11-08-ssao-deinterleave): a texel's sample rotation depends on its
+// phase in a 2x2 block, and the four phases of a 16x16 tile run in four separate groups. All threads of a SIMD
+// group then share one rotation: their sample offsets are alike and their depth reads hit neighbouring texels.
+// A white rotation per texel made neighbours read far apart lines of the cache and diverge on every branch.
+const int interleave = 2;
+
+ivec2 deinterleavedTexel() {
+  const ivec2 group = ivec2(gl_WorkGroupID.xy);
+  const ivec2 tile  = group/interleave;
+  const ivec2 phase = group%interleave;
+  return (tile*ivec2(gl_WorkGroupSize.xy) + ivec2(gl_LocalInvocationID.xy))*interleave + phase;
+  }
+
+float sampleRotation(ivec2 texel) {
+  // 2x2 Bayer order of the phases. A phase turns the 32 azimuths of the set by a quarter turn and a quarter of
+  // their step: the blur mixes the four into 128 azimuths, each elevation at four of them about 90 deg apart.
+  const ivec2 p   = texel & 1;
+  const uint  idx = uint(((p.x ^ p.y) << 1) | p.y);
+  // one more turn per 16x8 region, the footprint of a SIMD group: no single kernel over the whole screen
+  const float region = wangHashNoise(uvec2(texel.x >> 4, texel.y >> 3), 0);
+  return M_PI*2.0*(region + float(idx)*(0.25 + 1.0/128.0));
+  }
