  "speech_brows": {
    "about": "The brows of the speaker on the accents of its voice (eyes.md, 'План: брови по тону'): a syllable where the tone rises rise_st semitones within rise_ms and the voice reaches loud raises them (up) from lead_ms before it; an angry or hostile line lowers them (down: S_ANGRY already holds the brows near 1, so the squint and the sneer carry the stress there). A gap and a chance by the seed keep them off most accents (about one move in 2.4 s on 42 voice samples). Limits picked by the clip, the look is the user's.",
    "rise_st": 3,
    "rise_ms": 200,
    "syllable_ms": 150,
    "loud": 0.5,
    "lead_ms": 100,
    "on_ms": 120,
    "hold_ms": 150,
    "off_ms": 300,
    "gap_ms": 1000,
    "chance": 0.7,
    "up": {
      "browInnerUp": 0.801,
      "browOuterUpLeft": 0.104,
      "browOuterUpRight": 0.104
    },
    "down": {
      "browDownLeft": 0.33,
      "browDownRight": 0.33,
      "eyeSquintLeft": 0.25,
      "eyeSquintRight": 0.25,
      "noseSneerLeft": 0.15,
      "noseSneerRight": 0.15
    },
