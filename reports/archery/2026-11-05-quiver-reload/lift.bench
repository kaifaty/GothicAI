quiver lift on

# the reloads: slow (talent 0, dex 10), quick (talent 2, dex 150), the bow up
slowmo 4
stats str 30 dex 10 bow 10 talent 0
volley 1 300
cam follow 280 125 -80
rec slow_A
volley 3 300
wait 300
stop
cam follow 280 125 -140
rec slow_B
volley 3 300
wait 300
stop
stats str 120 dex 150 bow 100 talent 2
volley 1 300
cam follow 280 125 -80
rec fast_A
volley 3 300
wait 300
stop
cam follow 280 125 -140
rec fast_B
volley 3 300
wait 300
stop
tap parade
wait 1500

# the user's clip: the bow up and drawn, the shot, one reload, held, down; the player's camera and from the side (talent 0)
stats str 30 dex 10 bow 10 talent 0
cam game
rec user_t0_game
press action
wait 1200
release action
wait 2200
tap parade
wait 1800
stop
cam follow 260 120 -90
rec user_t0_side
press action
wait 1200
release action
wait 2200
tap parade
wait 1800
stop
slowmo 1
