# the reloads: slow (talent 0, dex 10), quick (talent 2, dex 150)
slowmo 4
stats str 30 dex 10 bow 10 talent 0
volley 1 300
cam follow 280 125 -80
rec slow_A
volley 3 300
wait 300
stop
cam follow 280 125 -140
rec slow_B
volley 3 300
wait 300
stop
