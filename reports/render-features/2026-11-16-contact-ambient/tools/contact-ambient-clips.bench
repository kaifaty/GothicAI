# The short occlusion over the light of the GI probes (../README.md), the clips of the acceptance: the user judges
# «без затенения | с затенением» by eye. Two runs record the same clips, without it (OPENGOTHIC_GI_CONTACT_AO=0) and
# the game's; ../../2026-11-15-night-interiors/tools/lamp_contact_clips.py puts them side by side:
#   lamp_contact_clips.py <without> <with> <out> --labels 'без затенения' 'с затенением' --prefix contact-ambient-
#   OPENGOTHIC_RT=1 OPENGOTHIC_LIGHT_FREEZE=1 TEMPEST_WINDOW_SIZE=1920x1080 BENCH_HOST=ryzen \
#     OPENGOTHIC_CONTENT=<the working content> [OPENGOTHIC_GI_CONTACT_AO=0] scripts/bench.sh <this file> <out>
# @timeout 900
seed 73013
cheat god
blink off
overlay off
ui off
view full
cam lift off
# 1. The market in the evening shade: the hero turns on the spot before a held camera at his feet, then walks
#    before the game's camera
goto NW_CITY_MERCHANT_TRADE_04
freeze PAL_203_LOTHAR
watch player
set time 20 30
wait 4000
cam cut
cam look 25
cam world 160 45 60
wait 3000
cam hold
rec shade-feet-turn
wait 1000
hold turnl 6000
wait 7000
stop
cam game
wait 3000
rec shade-walk
wait 1000
hold turnl 2500
wait 3000
walkmode walk
hold forward 5000
wait 5500
stop
# 2. A table of the upper city by day, the window's light alone: a slow pan over the candle, the mug and the bowl
set time 12 0
goto NW_CITY_UPTOWN_HUT_01_COOK
clear 3000
wait 6000
cam at 11798 1100 -4960 11760 995 -5150
wait 3000
cloth camera-turn -12 1
wait 1500
rec table-day-pan
wait 1000
cloth camera-turn 24 7000
wait 8000
stop
# 3. The meadow in the evening, the wind as the game's: the hero walks through the grass before the game's camera
set time 20 30
goto pos 41001 3440 -507
clear 3000
streaming wait
grass wait
wait 4000
watch player
cam game
wait 3000
rec meadow-walk
wait 1000
walkmode walk
hold forward 6000
wait 6500
stop
# 4. The forest by day: the hero walks along the path before the game's camera
set time 12 0
goto NW_FOREST_PATH_16
clear 3000
streaming wait
grass wait
wait 5000
watch player
cam game
wait 3000
rec forest-walk
wait 1000
walkmode walk
hold forward 6000
wait 6500
stop
