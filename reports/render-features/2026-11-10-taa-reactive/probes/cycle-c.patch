+// PROBE (reports/render-features/2026-11-10-taa-reactive/mac-cost.md, probes/cycle.patch): the probes of the mask's
+// cost on the Mac, by phase. OPENGOTHIC_PROBE_CYCLE=<ms> switches the phase every <ms> of steady_clock, at the start of
+// Renderer::draw; the analysis takes the phase of a frame from its frameprofile.csv row. Without it, phase 7 (none).
+uint32_t gTaaProbeFlags = 0;
+static const uint32_t taaProbePhases[8] = {
+  TaaProbe::MaskOff,                                                            // 0 O: the mask off, as taaReactive=0
+  TaaProbe::MaskOff | TaaProbe::AttNone,                                        // 1 the pass without the attachment
+  TaaProbe::MaskOff | TaaProbe::AttNoStore,                                     // 2 the attachment not stored
+  TaaProbe::MaskOff | TaaProbe::AttNoClear,                                     // 3 the attachment not cleared
+  TaaProbe::MaskOff | TaaProbe::ResNoMask,                                      // 4 the resolve of a545f43a4
+  TaaProbe::MaskOff | TaaProbe::PfxNoPush,                                      // 5 no push data per particle bucket
+  TaaProbe::MaskOff | TaaProbe::AttNone | TaaProbe::ResNoMask | TaaProbe::PfxNoPush, // 6 Z: all of the mask taken out
+  0,                                                                            // 7 N: as main, the mask on
+  };
+
+void Renderer::updateTaaProbe() {
+  static const uint64_t phaseNs = [] {
+    const char* e = std::getenv("OPENGOTHIC_PROBE_CYCLE");
+    const uint64_t ms = e ? uint64_t(std::strtoull(e, nullptr, 10)) : 0;
+    Log::i("render: probe cycle = ", int(ms), " ms");
+    return ms*1000000ull;
+    }();
+  if(phaseNs==0) {
+    gTaaProbeFlags = 0;
+    return;
+    }
+  const uint64_t now = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                  std::chrono::steady_clock::now().time_since_epoch()).count());
+  gTaaProbeFlags = taaProbePhases[(now/phaseNs)%8];
+  }
