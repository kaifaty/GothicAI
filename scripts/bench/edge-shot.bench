# Manual shooting down over Lobart's roof: the same frozen wolf below the gable wall.
# stand_manual: exactly 60 cm after drawing; automatic steps bring the hero to the edge, then lean clears the shot.
# close_manual: exactly 30 cm after drawing, a clear shot below 70 degrees must hit the wolf.
# auto_step_60/100: start exactly 60/100 cm back, step without movement input, then hit the same wolf.
# no_step_200: exactly 2 m back, hold the same downward aim without stepping.
# aimat ... mouse drives the actual game camera and crosshair; all shooting PNGs include its UI.
# probe_manual_zero/full: applied-head prediction checks at 60 cm, including the full 70-degree pose.
# Guard checks inherited from #77: drawn forward steps stop 20..35 cm before the edge, raising at
# 35 cm stays on the roof, and the hero can retreat or leave the stop sideways. Both bow and crossbow.
cheat god
set time 12 0
overlay off
view full
stats bow 100 talent 0
equip ItRw_Bow_L_01
give ItRw_Arrow 50
goto pos 14591 2349 -14597
wait 600
face 247.5
edge 247.5 2000 60 exact
wait 300
clear 2500
insert Wolf
wait 300
immortal WOLF on
put WOLF 160 0
# Keep the ground position fixed through hit reactions, so every segment shoots the same steep target.
pin WOLF 160 0 -733
wait 300
cam lift off
aim off
draw bow
wait 1500
aimat WOLF body mouse
cam game
ui on
press action
wait 1500
# Drawing has root motion: place the fully drawn hero at the exact margin.
goto pos 14591 2349 -14597
wait 400
face 247.5
edge 247.5 2000 60 exact
wait 300
rec stand_manual
sight WOLF
cansee WOLF 247.5
anims
pos
edgedist 247.5
shot stand_manual_upright
wait 100
aim on
wait 2500
cansee WOLF 247.5
anims
pos
edgedist 247.5
shot stand_manual_drawn
wait 100
hp WOLF
release action
wait 1500
hp WOLF
stop
# Diagnose the same drawn animation and game camera at both endpoints. The forced 70-degree shot
# records its actual impact before restoring automatic lean, including any geometric limit at 60 cm.
# Fixed aimlean overrides suppress automatic approach, so restore the original 60 cm geometry first.
aim off
aimlean 0
press action
wait 1500
goto pos 14591 2349 -14597
wait 400
face 247.5
edge 247.5 2000 60 exact
wait 300
aim on
wait 1200
rec probe_manual_zero
wait 600
pos
edgedist 247.5
cansee WOLF 247.5
shot stand_manual_zero
wait 100
stop
aimlean 70
wait 1200
rec probe_manual_full
wait 600
pos
edgedist 247.5
cansee WOLF 247.5
shot stand_manual_full70
wait 100
hp WOLF
release action
wait 1500
hp WOLF
stop
aim off
aimlean auto
wait 1200
wait 800
aimat off
# Keep the same frozen wolf at its original world position. Draw before exact placement.
disarm
goto pos 14591 2349 -14597
cheat full
ani player S_RUN
wait 400
aim off
draw bow
wait 1500
aimat WOLF body mouse
cam game
ui on
press action
wait 1500
goto pos 14591 2349 -14597
wait 400
face 247.5
edge 247.5 2000 30 exact
wait 300
rec close_manual
sight WOLF
pos
edgedist 247.5
shot close_manual_upright
wait 100
aim on
wait 2500
pos
edgedist 247.5
cansee WOLF 247.5
anims
hp WOLF
shot close_manual_drawn
wait 100
release action
wait 1500
hp WOLF
stop
aimat off
# Explicit approach checks: draw with procedural aim disabled, then place at the exact starting margin.
# The wolf stays at its original world position and the real camera tracks it as the hero steps forward.
disarm
goto pos 14591 2349 -14597
cheat full
ani player S_RUN
wait 400
aim off
draw bow
wait 1500
aimat WOLF body mouse
cam game
ui on
press action
wait 1500
goto pos 14591 2349 -14597
wait 400
face 247.5
edge 247.5 2000 60 exact
wait 300
rec auto_step_60
sight WOLF
pos
edgedist 247.5
cansee WOLF 247.5
shot auto_step_60_start
wait 100
aim on
wait 4000
pos
edgedist 247.5
cansee WOLF 247.5
anims
hp WOLF
shot auto_step_60_drawn
wait 100
release action
wait 1500
hp WOLF
stop
aimat off
aim off
disarm
goto pos 14591 2349 -14597
cheat full
ani player S_RUN
wait 400
draw bow
wait 1500
aimat WOLF body mouse
cam game
ui on
press action
wait 1500
goto pos 14591 2349 -14597
wait 400
face 247.5
edge 247.5 2000 100 exact
wait 300
rec auto_step_100
sight WOLF
pos
edgedist 247.5
cansee WOLF 247.5
shot auto_step_100_start
wait 100
aim on
wait 4000
pos
edgedist 247.5
cansee WOLF 247.5
anims
hp WOLF
shot auto_step_100_drawn
wait 100
release action
wait 1500
hp WOLF
stop
aimat off
aim off
disarm
goto pos 14591 2349 -14597
cheat full
ani player S_RUN
wait 400
draw bow
wait 1500
aimat WOLF body mouse
cam game
ui on
press action
wait 1500
goto pos 14591 2349 -14597
wait 400
face 247.5
edge 247.5 2000 200 exact
wait 300
rec no_step_200
sight WOLF
pos
edgedist 247.5
cansee WOLF 247.5
shot no_step_200_start
wait 100
aim on
wait 4000
pos
edgedist 247.5
cansee WOLF 247.5
anims
shot no_step_200_drawn
wait 100
stop
release action
aimat off
ui off
cam follow 600 300 90
cam look -240
wait 800
# Bow, drawn manual steps: from 2 m back, walk forward for 3 s until the guard stops the hero.
edge 247.5 2000 200
wait 300
face 247.5
pos
aimat WOLF body
rec walk_manual
press action
wait 1200
press forward
wait 3000
release forward
wait 1500
pos
edgedist 247.5
cansee WOLF 247.5
anims
stop
release action
aimat off
wait 600
# At exactly 35 cm, raising/drawing without movement must not carry the hero over the edge.
# Restore standing before each setup; a previous fall or weapon state must not hide the check.
immortal WOLF on
disarm
goto pos 14591 2349 -14597
cheat full
ani player S_RUN
wait 400
draw bow
wait 1500
face 247.5
edge 247.5 2000 35 exact
aimat WOLF body
rec raise_manual_bow
anims
pos
edgedist 247.5
press action
wait 2500
pos
edgedist 247.5
anims
stop
release action
wait 600
aimat off

disarm
goto pos 14591 2349 -14597
cheat full
ani player S_RUN
wait 400
equip ItRw_Crossbow_L_01
give ItRw_Bolt 100
stats cbow 100 talent 0
draw bow
wait 1500
face 247.5
edge 247.5 2000 35 exact
aimat WOLF body
rec raise_manual_cbow
anims
pos
edgedist 247.5
press action
wait 2500
pos
edgedist 247.5
anims
stop
release action
wait 600
aimat off
# Crossbow counterpart of walk_manual.
disarm
goto pos 14591 2349 -14597
cheat full
ani player S_RUN
wait 400
draw bow
wait 1500
face 247.5
edge 247.5 2000 200
wait 300
face 247.5
aimat WOLF body
rec walk_manual_cbow
anims
press action
wait 1200
press forward
wait 3000
release forward
wait 1500
pos
edgedist 247.5
anims
stop
release action
aimat off
wait 600
# Leave the guard stop: retreat with the crossbow drawn, then step sideways with it carried.
aimat WOLF body
rec retreat_manual_cbow
press action
wait 1200
hold forward 600
wait 600
pos
edgedist 247.5
hold back 800
wait 800
pos
edgedist 247.5
stop
release action
aimat off
wait 800
walkmode walk
rec escape_manual_cbow
pos
edgedist 247.5
hold back 600
wait 600
pos
edgedist 247.5
hold right 600
wait 600
pos
edgedist 247.5
stop
walkmode run
