wait 200
view hide animated morph pfx
wait 1000
shot hut-day-1-bare
wait 200
view full
wait 3000
cam world 180 170 180
wait 300
cam hold
shot hut-day-2
wait 200
view hide animated morph pfx
wait 1000
shot hut-day-2-bare
wait 200
view full
wait 1000
set time 23 0
wait 3000
cam world 180 170 0
wait 300
cam hold
shot hut-night-1
wait 200
view hide animated morph pfx
wait 1000
shot hut-night-1-bare
wait 200
view full
wait 1000
# The response of the probes' light (step 2a): 22:00 -> 12:00 in the same view, 30 frames per second.
set time 22 0
wait 2000
rec hut-response
wait 1000
set time 12 0
wait 2000
stop

