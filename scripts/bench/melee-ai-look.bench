# Charge (PR melee-ai-special): a master's charged first blow lands on the hero standing still, then the hero
# dodges a real release, then parries one (the parried release stuns the bandit). Each a long fight take; the
# charges are the moments of ai_charge_release in events.jsonl.
mark charge
still player on
melee-shadow weapon 1h
wait 600
put-at player 61737 2198 -13323
put-at BDT_1013_BANDIT_L 61796 2195 -13461
face npc BDT_1013_BANDIT_L
wait 1000
cam two BDT_1013_BANDIT_L 380 60 1
rec charge-hit
fight BDT_1013_BANDIT_L player
wait 40000
stop
freeze BDT_1013_BANDIT_L
stop shadow
wait 6000
melee-shadow weapon 1h
put-at player 61737 2198 -13323
put-at BDT_1013_BANDIT_L 61796 2195 -13461
face npc BDT_1013_BANDIT_L
wait 1000
melee-ai-response dodge BDT_1013_BANDIT_L
rec charge-dodge
fight BDT_1013_BANDIT_L player
wait 30000
stop
freeze BDT_1013_BANDIT_L
stop shadow
wait 6000
melee-shadow weapon 1h
put-at player 61737 2198 -13323
put-at BDT_1013_BANDIT_L 61796 2195 -13461
face npc BDT_1013_BANDIT_L
wait 1000
melee-ai-response parry BDT_1013_BANDIT_L
rec charge-parry
fight BDT_1013_BANDIT_L player
wait 30000
stop
freeze BDT_1013_BANDIT_L
stop shadow
wait 6000

still player off
release all

# Two NPCs: a master bandit against a guard in medium armour, an ordinary fight; the hero stands 8 m away.
mark npc-duel
arc MIL_322_MILIZ 1 600 0
npcequip MIL_322_MILIZ ITMW_1H_COMMON_01
stats npc MIL_322_MILIZ hpmax 100000 hp 100000 str 60 1h 60 talent auto
immortal MIL_322_MILIZ on
put-at player 61424 2150 -12587
wait 300
put-at BDT_1013_BANDIT_L 61737 2198 -13323
put-at MIL_322_MILIZ 61853 2188 -13596
wait 800
fight BDT_1013_BANDIT_L MIL_322_MILIZ
fight MIL_322_MILIZ BDT_1013_BANDIT_L
watch BDT_1013_BANDIT_L
cam follow 440 170 90
rec npc-duel
wait 30000
stop
watch player
release all
