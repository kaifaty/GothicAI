# Forest road outside Khorinis: vegetation and long views over the native world.
seed 73013
cheat god
set time 12 0
cadence normal
overlay off
ui off
view full
cam lift off
goto NW_FOREST_PATH_16
watch player
cam look 150
cam world 500 230 0
# Ten real seconds after the teleport for loading and native simulation.
wait 10000
cam hold
perf sample perf-forest/view-1
wait 8000
perf stop
cam world 500 230 90
wait 34
cam hold
perf sample perf-forest/view-2
wait 8000
perf stop
cam world 500 230 180
wait 34
cam hold
perf sample perf-forest/view-3
wait 8000
perf stop
cam world 500 230 270
wait 34
cam hold
perf sample perf-forest/view-4
wait 8000
perf stop
