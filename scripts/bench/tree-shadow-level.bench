# Capture full-geometry and independently selected spruce shadows at the same camera and world tick.
# Use the tree-impostor forest set with its L1-L4 and the campfire at (53325,1675,-10448).
# Use OPENGOTHIC_VSM_PAIRS=4194304 and OPENGOTHIC_VSM_STATS=1. Wait for one sample under each reference frame.
# The normal-cap measurements use tree-shadow-level-pairs.bench with OPENGOTHIC_VSM_STATS=1.
# Use OPENGOTHIC_FOLIAGE=light, OPENGOTHIC_EYE=0, OPENGOTHIC_TAA=0 and OPENGOTHIC_UPSCALE=off
# to isolate the shadow comparison. Each streaming wait pins texture residency until its shot.
# The near view also repeats the full caster and records the opaque depth and view projection.
# @timeout 240
seed 73013
cheat god
overlay off
ui off
view full
deterministic on
set time 12 0

# About 6 m from the trunk of tree-cost-4-7, looking at the ground behind it.
goto pos 54140 1650 -10780
clear 3000
cam at 53990 1760 -10780 54680 1570 -11040
wait real 6000
ztimer multiplyer 0
impostor probe on
shadow levels full
wait real 750
log shadow-pairs under-6m full begin
wait real 6500
streaming wait
pos
shot under-6m-full
wait 200
log shadow-pairs under-6m full end
shadow levels on
wait real 750
log shadow-pairs under-6m on begin
wait real 6500
streaming wait
pos
shot under-6m-on
wait 200
log shadow-pairs under-6m on end
shadow levels full
wait real 750
log shadow-pairs under-6m full-repeat begin
wait real 6500
streaming wait
pos
shot under-6m-full-repeat
wait 200
log shadow-pairs under-6m full-repeat end
impostor probe off
shadow levels on
ztimer realtime

# The 30 m and 100 m cameras from perf-trees.bench.
goto pos 48765 6250 -3156
clear 5000
cam at 48765 6679 -3156 54140 2190 -10780
wait real 6000
ztimer multiplyer 0
shadow levels full
wait real 750
log shadow-pairs near-30 full begin
wait real 6500
streaming wait
pos
shot near-30-full
wait 200
log shadow-pairs near-30 full end
shadow levels on
wait real 750
log shadow-pairs near-30 on begin
wait real 6500
streaming wait
pos
shot near-30-on
wait 200
log shadow-pairs near-30 on end
ztimer realtime

goto pos 42364 1700 -8973
clear 5000
cam at 42364 1808 -8973 54140 2490 -10780
wait real 6000
ztimer multiplyer 0
shadow levels full
wait real 750
log shadow-pairs far-100 full begin
wait real 6500
streaming wait
pos
shot far-100-full
wait 200
log shadow-pairs far-100 full end
shadow levels on
wait real 750
log shadow-pairs far-100 on begin
wait real 6500
streaming wait
pos
shot far-100-on
wait 200
log shadow-pairs far-100 on end
ztimer realtime

# Campfire 11714 and its light 11715. tree-cost-3-8 stands between the camera and the fire's pool.
set time 0 0
goto pos 54140 1650 -10780
clear 3000
cam at 54140 1760 -10780 53580 1650 -10450
wait real 8000
ztimer multiplyer 0
shadow levels full
wait real 750
log shadow-pairs lamp-night full begin
wait real 6500
streaming wait
pos
shot lamp-night-full
wait 200
log shadow-pairs lamp-night full end
shadow levels on
wait real 750
log shadow-pairs lamp-night on begin
wait real 6500
streaming wait
pos
shot lamp-night-on
wait 200
log shadow-pairs lamp-night on end
ztimer realtime
