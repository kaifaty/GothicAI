# Paired hero riposte: run unchanged with MELEE_RIPOSTE=1 and 0.
# WORLD=NEWWORLD.ZEN OPENGOTHIC_BODY_TRACE=1 MELEE_STAMINA=1 MELEE_STAGGER=1 MELEE_BACKSTAB=1
# OPENGOTHIC_CONTENT=/Users/kaifat/.local/share/gothic-ai/content-staging/anim-strikes
# Metrics only. Marks delimit each case; bench.log and body_combat carry damage, timing and animation truth.
# Pin holds the preparation; release it at the press so convergence and the native fall can move the victim.
seed 73013
set time 12 0
release all
overlay off
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
wait 500
watch player
clear 3000
corner right go 0
melee-shadow setup 1h
stats hp 100000 hpmax 100000
wait 600
melee-shadow target 2
wait 600
# Park on actual ground: a distant pin at the hero's height can leave a falling actor.
put WOLF 5000 90
put WOLF 5000 -90
turn 180
wait 2000
rec riposte novideo

# (a) Classic: blade at 400 ms, handover at 840 ms. At blade the victim is 155..175 cm from
# the hero's starting root; the moving roots are 110..130 cm apart. Snapshots follow each event by one frame.
pin BDT_1013_BANDIT_L 150 0 0
wait 100
mark a-classic-150
stun BDT_1013_BANDIT_L posture
pair player BDT_1013_BANDIT_L
press action
hold forward 100
pin off
wait 420
watch BDT_1013_BANDIT_L
anims
pair player BDT_1013_BANDIT_L
watch player
anims
wait 420
watch BDT_1013_BANDIT_L
anims
watch player
wait 1600
hp BDT_1013_BANDIT_L
pair player BDT_1013_BANDIT_L
release all
wait 8000

# Both control schemes reach the same entry point.
melee-shadow controls g2
pin BDT_1013_BANDIT_L 150 0 0
wait 100
mark a-g2-150
stun BDT_1013_BANDIT_L posture
hold attack 100
pin off
wait 420
watch BDT_1013_BANDIT_L
anims
pair player BDT_1013_BANDIT_L
watch player
wait 420
watch BDT_1013_BANDIT_L
anims
watch player
wait 1600
hp BDT_1013_BANDIT_L
wait 8000

# (b) The target starts 230 cm away and moves towards the 165 cm pair point.
pin BDT_1013_BANDIT_L 230 0 0
wait 100
mark b-g2-230
stun BDT_1013_BANDIT_L posture
pair player BDT_1013_BANDIT_L
hold attack 100
pin off
wait 200
pair player BDT_1013_BANDIT_L
wait 220
pair player BDT_1013_BANDIT_L
watch BDT_1013_BANDIT_L
anims
watch player
wait 420
watch BDT_1013_BANDIT_L
anims
watch player
wait 1600
hp BDT_1013_BANDIT_L
wait 8000

# (d) A second bandit's ordinary damage path hurts the hero without interrupting the riposte.
insert BDT_1003_BANDIT_M
put BDT_1003_BANDIT_M 350 90
stats npc BDT_1003_BANDIT_M str 1000
wait 100
pin BDT_1013_BANDIT_L 150 0 0
wait 100
mark d-hero-super-armor
stun BDT_1013_BANDIT_L posture
hold attack 100
pin off
wait 300
strike player BDT_1003_BANDIT_M
anims
tap dodge
wait 560
watch BDT_1013_BANDIT_L
anims
watch player
anims
wait 1600
anims
put BDT_1003_BANDIT_M 5000 90
wait 8000

# (e) No stun: with charge enabled a short press starts the ordinary swing only on release.
pin BDT_1013_BANDIT_L 150 0 0
wait 100
mark e-not-stunned
hold attack 100
wait 34
anims
wait 1600
hp BDT_1013_BANDIT_L
pin off
wait 6000

# (f) The hero moves behind the frozen target after the pin is released; the rear path remains a backstab.
pin BDT_1013_BANDIT_L 150 0 0
wait 100
pin off
stun BDT_1013_BANDIT_L posture
watch BDT_1013_BANDIT_L
place 150 180
watch player
mark f-stunned-rear
pair player BDT_1013_BANDIT_L
hold attack 100
wait 1600
hp BDT_1013_BANDIT_L
wait 6000

# (g) Both out-of-range and out-of-cone targets must keep ordinary input behavior.
pin BDT_1013_BANDIT_L 300 0 0
wait 100
mark g-distance-300
stun BDT_1013_BANDIT_L posture
pair player BDT_1013_BANDIT_L
hold attack 100
pin off
wait 1800
wait 6000
pin BDT_1013_BANDIT_L 150 60 0
wait 100
mark g-angle-60
stun BDT_1013_BANDIT_L posture
pair player BDT_1013_BANDIT_L
hold attack 100
pin off
wait 1800
wait 6000

# (h) Two-handers, fists and beasts cannot enter the paired move.
melee-shadow weapon 2h
wait 600
pin BDT_1013_BANDIT_L 150 0 0
wait 100
mark h-two-handed
stun BDT_1013_BANDIT_L posture
hold attack 100
pin off
wait 1800
anims
wait 6000
melee-shadow weapon fist
wait 600
pin BDT_1013_BANDIT_L 150 0 0
wait 100
mark h-fist
stun BDT_1013_BANDIT_L posture
hold attack 100
pin off
wait 1800
anims
wait 6000
melee-shadow weapon 1h
wait 600
melee-shadow target 0
turn 180
put BDT_1013_BANDIT_L 5000 90
pin WOLF 150 0 0
wait 100
mark h-stunned-wolf
stun WOLF posture
pair player WOLF
hold attack 100
pin off
wait 1800
hp WOLF
wait 6000

# Marvin changes the same switch. ON becomes ordinary x1.5; OFF becomes a paired x3 hit.
melee-shadow target 2
wait 600
turn 180
put WOLF 5000 90
put WOLF 5000 -90
pin BDT_1013_BANDIT_L 150 0 0
wait 100
toggle melee_riposte
mark toggle-inverted
stun BDT_1013_BANDIT_L posture
pair player BDT_1013_BANDIT_L
watch BDT_1013_BANDIT_L
anims
watch player
anims
hold attack 100
pin off
wait 2400
toggle melee_riposte
wait 8000

# (c) Last because this hostile bandit must die through the ordinary health/death path.
pin BDT_1013_BANDIT_L 150 0 0
wait 100
stats npc BDT_1013_BANDIT_L hp 1
mark c-lethal
stun BDT_1013_BANDIT_L posture
pair player BDT_1013_BANDIT_L
watch BDT_1013_BANDIT_L
anims
watch player
anims
hold attack 100
pin off
wait 420
watch BDT_1013_BANDIT_L
anims
watch player
wait 420
watch BDT_1013_BANDIT_L
anims
watch player
wait 1600
hp BDT_1013_BANDIT_L
pair player BDT_1013_BANDIT_L
release all
stop
