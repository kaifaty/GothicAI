# Native 1H charges. Run unchanged with MELEE_AI_CHARGE=1 and 0.
# WORLD=NEWWORLD.ZEN OPENGOTHIC_BODY_TRACE=1 MELEE_CHARGE=1 MELEE_STAMINA=1 MELEE_POSTURE=0
# MELEE_STAGGER=1 MELEE_PARRY=1 MELEE_AI_DODGE=0 TIMEOUT=900
# OPENGOTHIC_CONTENT=/Users/kaifat/.local/share/gothic-ai/content-staging/anim-strikes
# Metrics only: ai_charge_roll/ai_charge_release contain chance and hold timing.
# Measure release rotation from ai_charge_end.turn_deg and the bench.log line "release turn ... deg".
# ai_special_start/end measure occupancy by target; native_attempt keeps the ordinary attack denominator.
# Response fixtures observe a real AI release and use the hero's ordinary dodge/parade entry points.
seed 73013
set time 12 0
release all
overlay off
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
wait 500
watch player
clear 3000
corner right go 0
melee-shadow setup 1h
stats hp 1000000 hpmax 1000000 str 100 1h 100 talent auto
wait 600
melee-shadow target 2
wait 600
put WOLF 5000 90
put WOLF 5000 -90
turn 180
melee-shadow controls g2
immortal player on
still player on
stats npc BDT_1013_BANDIT_L hpmax 1000000 hp 1000000 str 100 1h 100 talent auto
immortal BDT_1013_BANDIT_L on
put BDT_1013_BANDIT_L 150 0
wait 2000

# (a) Master, 120 seconds of native fighting. Count eligible stand attacks, charge rolls and holds.
rec a-talent100 novideo
mark a-talent100
fight BDT_1013_BANDIT_L player
wait 120000
hp player
pair BDT_1013_BANDIT_L player
watch BDT_1013_BANDIT_L
anims
watch player
freeze BDT_1013_BANDIT_L
stop shadow
wait 8000

# (b1) A real charged release meets the hero's lateral dodge: invulnerability and no damage.
melee-shadow bandit 1h
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
wait 1000
rec b-dodge novideo
mark b-dodge
melee-ai-response dodge BDT_1013_BANDIT_L
fight BDT_1013_BANDIT_L player
wait 45000
hp player
pair BDT_1013_BANDIT_L player
freeze BDT_1013_BANDIT_L
stop shadow
wait 8000

# (b2) A real charged release meets an ordinary parade timed 120 ms before contact.
melee-shadow bandit 1h
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
wait 1000
rec b-parry novideo
mark b-parry
melee-ai-response parry BDT_1013_BANDIT_L
fight BDT_1013_BANDIT_L player
wait 45000
hp player
watch BDT_1013_BANDIT_L
anims
watch player
freeze BDT_1013_BANDIT_L
stop shadow
wait 8000

# (c) Talent zero keeps ordinary native attacks throughout 60 seconds.
stats npc BDT_1013_BANDIT_L 1h 0 talent auto
melee-shadow bandit 1h
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
wait 1000
rec c-talent0 novideo
mark c-talent0
fight BDT_1013_BANDIT_L player
wait 60000
hp player
freeze BDT_1013_BANDIT_L
stop shadow
wait 8000

# (d) Two masters fight the same hero. Charges share one target slot.
stats npc BDT_1013_BANDIT_L 1h 100 talent auto
melee-shadow bandit 1h
arc BDT_1003_BANDIT_M 1 180 0
stats npc BDT_1003_BANDIT_M hpmax 1000000 hp 1000000 str 100 1h 100 talent auto
immortal BDT_1003_BANDIT_M on
melee-shadow bandit 1h BDT_1003_BANDIT_M
put BDT_1013_BANDIT_L 150 -20
put BDT_1003_BANDIT_M 150 20
face npc BDT_1013_BANDIT_L
wait 1000
rec d-two-bandits novideo
mark d-two-bandits
fight BDT_1013_BANDIT_L player
fight BDT_1003_BANDIT_M player
wait 90000
pair BDT_1013_BANDIT_L player
pair BDT_1003_BANDIT_M player
freeze BDT_1013_BANDIT_L
freeze BDT_1003_BANDIT_M
stop shadow
put BDT_1003_BANDIT_M 5000 90
wait 8000

# Runtime switch: ON becomes the ordinary native control, OFF permits charges; restore afterwards.
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
wait 1000
toggle melee_ai_charge
rec toggle-inverted novideo
mark toggle-inverted
fight BDT_1013_BANDIT_L player
wait 30000
freeze BDT_1013_BANDIT_L
stop shadow
toggle melee_ai_charge
release all
