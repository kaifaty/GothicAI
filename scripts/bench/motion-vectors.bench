# Motion vectors of objects (graphics plan 1b, reports/render-features/2026-11-10-motion-vectors): stills of the
# debug view, which shows gbufMotion in place of the frame (hue the direction, brightness the length, black exactly 0).
#   OPENGOTHIC_MOTION_VECTORS=1 OPENGOTHIC_MOTION_VIEW=1 TEMPEST_WINDOW_SIZE=1920x1080 BENCH_HOST=ryzen \
#     scripts/bench.sh scripts/bench/motion-vectors.bench <absolute out>
# With OPENGOTHIC_MOTION_VECTORS=0 every still must be black. A bench step is 1/30 s, so a vector is the move of
# one such step. `where` lines in bench.log give the walker's speed.
seed 73013
cheat god
set time 12 0
overlay off
ui off
view full
cam lift off
# 1. A still world, the camera moves: no creatures drawn, indoors (no wind). The residual must be 0 everywhere
set time 22 0
goto pos 3924 -73 -6663
watch player
view hide animated morph
cam look 110
cam world 160 170 0
wait 10000
cam world 160 170 4
shot mv-still-turn
wait 34
cam world 220 200 9
shot mv-still-move
wait 34
view full
# 2. The market at noon: Lothar walks across a still camera; the passers-by walk too
set time 12 0
goto NW_CITY_MERCHANT_TRADE_04
watch player
freeze PAL_203_LOTHAR
cam look 120
cam world 700 280 90
wait 10000
cam hold
npcgo PAL_203_LOTHAR NW_CITY_MERCHANT_PATH_09 walk
wait 1500
where PAL_203_LOTHAR
wait 1000
where PAL_203_LOTHAR
shot mv-npc-walk
wait 34
shot mv-npc-walk-next
wait 34
# 3. The hero runs, the camera follows him
cam cut
goto NW_CITY_MERCHANT_TRADE_04
watch player
walkmode run
cam look 120
cam follow 380 170 160
wait 5000
walkto NW_CITY_MERCHANT_PATH_09
wait 1200
where player
wait 500
where player
shot mv-hero-run
wait 34
walkmode walk
# 4. A tree in the wind by the road to the farms, the camera stands
cam cut
goto NW_FARM1_PATH_CITY_13
watch player
cam look 300
cam world 600 200 180
wait 10000
cam hold
wait 1000
shot mv-tree-wind
wait 34
# 5. The forest road, leaves in the wind
cam cut
goto NW_FOREST_PATH_16
watch player
cam look 150
cam world 500 230 0
wait 10000
cam hold
shot mv-forest
wait 34
# 6. The town banner in a gust (physics cloth)
cam cut
cloth setup NW_CITY_FLAG_01:1 mv-banner
cloth on
cloth wind gust
wait 10000
shot mv-banner
wait 34
