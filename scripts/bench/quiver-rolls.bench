# --- light: the dash, to compare
equip ITAR_Leather_L
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
face 210
melee-shadow weapon 1h
stats 1h 45 talent 1
wait 2000
rec lea_dash_forward
wait 500
dodge player forward
wait 1200
stop
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
face 210
melee-shadow weapon 1h
stats 1h 45 talent 1
wait 2000
rec lea_dash_right
wait 500
dodge player right
wait 1200
stop

# --- the quiver on the ground, no thresholds. Sneaking with the bow on the back: light leather and the fire
# mage's robe (ITAR_KDF_H); the hero puts his sword away first
tap weapon
wait 1500
equip ITAR_Leather_L
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
face 210
wait 1500
walkmode sneak
rec lea_sneak
wait 500
hold forward 3000
wait 3000
release all
wait 500
stop
walkmode run
equip ITAR_KDF_H
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
face 210
wait 1500
walkmode sneak
rec kdf_sneak
wait 500
hold forward 3000
wait 3000
release all
wait 500
stop
walkmode run

# On the ground the camera looks down at the body: `view clean` would clip the ground before it (grey)
view full
# An npc bowman in ITAR_MIL_M sits down on the ground (as by a campfire), 3 m in front of the hero, facing 210 as
# he did; frozen (`put`), not to draw his weapon at the hero
equip ITAR_Leather_L
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
face 30
wait 300
insert BAU_904_BAUER
wait 300
npcequip BAU_904_BAUER ItRw_Bow_L_01
npcequip BAU_904_BAUER ITAR_MIL_M
arrows BAU_904_BAUER 20
put BAU_904_BAUER 300 0
watch BAU_904_BAUER
cam follow 200 115 -135
wait 1500
rec npc_sit_ground
wait 500
ani BAU_904_BAUER T_STAND_2_SIT force
wait 3500
stop
put BAU_904_BAUER 2500 90
watch player
wait 300

# The hero knocked down for real, the bow on his back, nothing frozen: a mercenary's two-hander on him stunned by
# posture (as knockdown-launch), from the blow till he is up again. Whether the bow (and the quiver) stays on
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
face 210
wait 500
arc SLD_826_SOELDNER 1 150 0
freeze SLD_826_SOELDNER
knockdown-launch-equip
watch player
cam follow 150 170 -90
cam look 0
wait 1500
rec hero_knockdown
wait 500
stun player posture
strike player SLD_826_SOELDNER
wait 6000
stop
