# Shoulder barge: run ON and OFF with MELEE_BARGE=1/0; the same heavy-forward presses must become
# T_1HBARGE or T_1HROLLHEAVYF respectively. Every case has a mark in events.jsonl and a named novideo
# recording. Read contact/stun/knockdown/damage and barge* body_combat events, plus anims/HP/positions.
# WORLD=NEWWORLD.ZEN OPENGOTHIC_BODY_TRACE=1
# OPENGOTHIC_CONTENT=/Users/kaifat/.local/share/gothic-ai/content-staging/anim-strikes
seed 73013
set time 12 0
release all
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
wait 500
clear 3000
corner right go 0
melee-shadow setup 1h
stats hp 100000 hpmax 100000
wait 600
melee-shadow target 2
wait 600
pin WOLF 5000 90 0
wait 34
pin off
pin WOLF 5000 -90 0
wait 34
pin off
# Turn away from the fixture's wall and signpost, into the open field.
turn 180
equip ITAR_PAL_H
put BDT_1013_BANDIT_L 100 0
wait 2000
watch player

# (a) A standing human at 1 m: ordinary input starts the barge, 1000 ms stun and fist damage.
rec a-standing novideo
mark barge-a-standing
hp BDT_1013_BANDIT_L
pos
press forward
tap dodge
wait 34
release forward
wait 66
anims
wait 550
hp BDT_1013_BANDIT_L
pos
wait 2000
stop

# (b) A posture-stunned human: the barge enters the existing heavy-on-staggered knockdown path.
wait 5000
put BDT_1013_BANDIT_L 100 0
rec b-stunned novideo
mark barge-b-stunned
stun BDT_1013_BANDIT_L posture
dodge forward
wait 100
anims
wait 600
hp BDT_1013_BANDIT_L
wait 8000
stop

# (c) Medium forward keeps the ordinary roll; (d) heavy backward keeps the slow roll.
put BDT_1013_BANDIT_L 1000 90
equip ITAR_MIL_M
wait 1500
rec c-medium-forward novideo
mark barge-c-medium-forward
dodge forward
wait 100
anims
wait 2400
stop

equip ITAR_PAL_H
wait 300
rec d-heavy-back novideo
mark barge-d-heavy-back
dodge back
wait 100
anims
wait 2400
stop

# (e) A huge beast: no damage or stun, the body's collision stops root motion, clip finishes.
insert Troll
put TROLL 100 0
stats npc TROLL hp 100000 hpmax 100000
wait 600
rec e-huge novideo
mark barge-e-huge
pos
hp TROLL
dodge forward
wait 100
anims
wait 550
pos
hp TROLL
wait 650
anims
pos
wait 1500
stop
put TROLL 5000 90

# (f) The ordinary damage path hits at 300 ms: HP falls while T_1HBARGE keeps playing.
# No god mode or bench-still: the barge itself must suppress the reaction.
put BDT_1013_BANDIT_L 100 0
wait 1000
rec f-super-armor novideo
mark barge-f-super-armor
dodge forward
wait 300
strike player BDT_1013_BANDIT_L
anims
wait 1000
anims
wait 1500
stop

# (g) Nothing in reach: the contact window ends in miss; OFF has no barge contact events.
put BDT_1013_BANDIT_L 5000 -90
wait 1000
rec g-miss novideo
mark barge-g-miss
pos
dodge forward
wait 100
anims
wait 1200
pos
wait 1500
stop
