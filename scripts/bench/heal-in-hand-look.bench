# Look of drinking and eating with a weapon in hand (step 7 part B: reports/Питьё с оружием в руке.md), video takes
# for the user's acceptance: the hero drinks with fists, 1H and 2H, eats bread, an apple and meat, drinks while
# walking, and a bandit's hit cuts a drink. Every take starts at the sunlit spot of melee-ai-look, 16 m into the
# field from the fixture; the bandit waits 8 m away except in the hit take. Slow takes run the game 4x slower.
# WORLD=NEWWORLD.ZEN BENCH_HOST=ryzen TIMEOUT=900 TEMPEST_WINDOW_SIZE=1280x720
# OPENGOTHIC_CONTENT=/abs/content-staging/anim-uses-1
seed 73013
set time 12 0
release all
overlay off
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
wait 500
watch player
clear 3000
corner right go 0
melee-shadow setup 1h
wait 600
melee-shadow target 2
wait 600
pin WOLF 5000 90 0
wait 34
pin off
pin WOLF 5000 -90 0
wait 34
pin off
turn 180
immortal BDT_1013_BANDIT_L on
wait 600

put-at BDT_1013_BANDIT_L 62250 2190 -14000
put-at player 61737 2198 -13323
healing begin drink-1h-left ItPo_Health_01 600
healing arm 1h
wait 900
cam follow 230 25 300
rec drink-1h-left
wait 300
healing use direct
wait 2000
stop

put-at BDT_1013_BANDIT_L 62250 2190 -14000
put-at player 61737 2198 -13323
healing begin drink-1h-right ItPo_Health_01 600
