# Native nonlethal starts; two pairs x three distances x six shared seeds.
# BENCH_HOST=ryzen WORLD=NEWWORLD.ZEN TIMEOUT=2700 RYZEN_MAX=75m scripts/bench.sh melee-far
# Each metrics-only segment retains both rolling shadow journals with stop shadow.
cheat god
release all
overlay off
set time 12 0
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
wait 500
watch player
clear 10000

# melee-far-12m-p1-s1: SLD_826_SOELDNER -> SLD_815_SOELDNER
watch player
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
face 0
clear 2500
set time 12 0
seed 1
arc SLD_826_SOELDNER 1 150 0
put SLD_826_SOELDNER 150 180
arc SLD_815_SOELDNER 1 150 0
put SLD_815_SOELDNER 150 0
wait 600
watch SLD_826_SOELDNER
place 1200 90
release all
where SLD_826_SOELDNER
where SLD_815_SOELDNER
seed 1
rec melee-far-12m-p1-s1 novideo
freeze SLD_815_SOELDNER off
fight SLD_826_SOELDNER SLD_815_SOELDNER deed
waitdown SLD_826_SOELDNER 60000 SLD_815_SOELDNER
freeze SLD_826_SOELDNER
freeze SLD_815_SOELDNER
wait 34
stop shadow
watch player
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
face 0
put SLD_826_SOELDNER 150 180
put SLD_815_SOELDNER 150 0
clear 2500

