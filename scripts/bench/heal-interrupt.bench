# WORLD=NEWWORLD.ZEN; run with MELEE_HEAL_INTERRUPT=1 FOOD_OVER_TIME=1, then both 0.
# Real useItem, native melee takeDamage and a native arrow collision; no scripted healing.
seed 73013
set time 12 0
release all
overlay off
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
wait 500
watch player
clear 3000
corner right go 0
melee-shadow setup 1h
wait 600
melee-shadow target 2
wait 600
pin WOLF 5000 90 0
wait 34
pin off
pin WOLF 5000 -90 0
wait 34
pin off
turn 180
pin BDT_1013_BANDIT_L 140 0 0
wait 300
pin off

# A complete drink: +50 on ITEM_DESTROY (OFF: the original immediate script).
healing begin potion ItPo_Health_01
equip ItPo_Health_01
wait 2500
healing check potion

# The scheduled frame ends exactly at the requested millisecond after useItem.
# Each retry consumes the kept potion, without giving another in the ON run.
healing begin hit-1 ItPo_Health_01
equip ItPo_Health_01
healing strike 1
wait 2500
healing check interrupted
healing retry
wait 2500
healing check potion
healing begin hit-300 ItPo_Health_01
equip ItPo_Health_01
healing strike 300
wait 2500
healing check interrupted
healing retry
wait 2500
healing check potion
healing begin hit-1400 ItPo_Health_01
equip ItPo_Health_01
healing strike 1400
wait 2500
healing check interrupted
healing retry
wait 2500
healing check potion

healing begin arrow ItPo_Health_01
equip ItPo_Health_01
wait 300
healing arrow
wait 2200
healing check interrupted
healing retry
wait 2500
healing check potion

# Per-second HP samples start at native ITEM_DESTROY; a complete pool gives +10.
healing begin bread ItFo_Bread
equip ItFo_Bread
wait 12000
healing check food 10

# The next apple adds to the remaining pool and extends its deadline.
healing begin five-apples ItFo_Apple
equip ItFo_Apple
wait 1800
equip ItFo_Apple
wait 1800
equip ItFo_Apple
wait 1800
equip ItFo_Apple
wait 1800
equip ItFo_Apple
wait 12000
healing check food 15

# The actual NPC saver/loader writes and reads the optional food-pool entry.
healing begin saved-bread ItFo_Bread
equip ItFo_Bread
wait 5500
healing save
wait 2000
healing load
wait 8000
healing check food 10

# Same actual player-control key-release path as the game, with sword drawn.
healing begin hotkey ItPo_Health_01
give ItPo_Health_01
melee-shadow weapon 1h
wait 600
release heal
wait 6000
healing check hotkey
