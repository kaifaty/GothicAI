# Rock material of the landscape pilot (step В3, reports/content/2026-11-landscape-pilot/b3-rock-material.md): the
# wall and the boulder by the road south of Akil's farm, a ledge seen from afar, the rock arch at the bandit camp,
# a walk along the wall, the wall at a low sun. The views of the layers probe; change them only with the note.
# Run with OPENGOTHIC_CONTENT=<set> and with OPENGOTHIC_CONTENT= (the original), put the frames side by side.
# @timeout 900
seed 73013
cheat god
overlay off
ui off
view full
walkmode run
watch player
cam game
set time 12 0

goto NW_FARM2_TO_TAVERN_02
clear 3000
face wp NW_FARM2_TO_TAVERN_04
streaming wait
wait 10000
shot road-1
wait 200
turn 90
wait 2500
shot road-2
wait 200
turn 90
wait 2500
shot road-3
wait 200
turn 90
wait 2500
shot road-4
wait 200

goto pos 35110 3829 429
clear 3000
streaming wait
cam at 35110 3969 429 35110 4139 1529
wait 10000
shot ledge
wait 200
# the grass band at the top of the lower wall of the same ledge, 5 m from it: the blades themselves
cam at 34800 3990 900 34800 4040 1390
wait 4000
shot ledge-near
wait 200

cam game
goto NW_FARM2_TO_TAVERN_05
clear 3000
face wp NW_FARM2_TO_TAVERN_06
streaming wait
wait 10000
shot arch
wait 200

goto NW_FARM2_TO_TAVERN_01
clear 3000
face wp NW_FARM2_TO_TAVERN_03
streaming wait
wait 5000
rec walk-rock
wait 1000
walkto NW_FARM2_TO_TAVERN_06
waitarrive 60000
wait 1000
stop

set time 17 30
goto NW_FARM2_TO_TAVERN_02
clear 3000
face wp NW_FARM2_TO_TAVERN_04
streaming wait
wait 10000
shot eve-1
wait 200
turn 180
wait 2500
shot eve-3
wait 200

# Living foliage (reports/engine/2026-11-14-living-foliage): the tufts of the same ledge in the world's own wind
# and against a low sun. Run with OPENGOTHIC_FOLIAGE=0 and without it, put the clips side by side.
set time 12 0
goto pos 35110 3829 429
clear 3000
streaming wait
cam at 34800 3990 900 34800 4040 1390
wait 4000
# the world's gust: every 19.35 s on the stand. Its peak is 7 s into the clip, its front comes at about 4.5 s
foliage wait-gust 7000
rec ledge-wind
wait 14000
stop
# the breeze between two gusts from the 14 m of `ledge`
cam at 35110 3969 429 35110 4139 1529
foliage wait-lull 4000
rec ledge-steady
wait 8000
stop

# a walk under the band, west along the foot of the lower wall, through the stretch where the tufts hang densest
# (x 34500..34900, in the sun at 14:00); the camera follows from behind and to the left, so the band stays in the
# frame for the whole walk; the swing shows the wind all the way, so the clip is not timed to a gust
walkmode walk
goto pos 35150 3640 1100
clear 3000
face 180
cam world 420 300 300
cam look 250
streaming wait
wait 3000
rec walk-ledge
wait 800
press forward
wait 5000
release forward
wait 2200
stop
walkmode run

# the sun 15 degrees high behind the tufts of the ledge's upper edge
set time 20 15
goto pos 35300 4200 1750
clear 3000
streaming wait
cam at 35398 4739 1945 35565 4812 2194
wait 8000
foliage wait-gust 4000
rec eve-backlit
wait 8000
stop
shot eve-backlit
wait 200
