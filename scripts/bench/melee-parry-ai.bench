# Native melee parry timing and retaliation after a real parry.
# WORLD=NEWWORLD.ZEN BENCH_HOST=local OPENGOTHIC_BODY_TRACE=1 MELEE_PARRY=1 MELEE_PARRY_AI=1 (then 0)
seed 73013
cheat god
set time 12 0
release all
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
wait 500
clear 3000
