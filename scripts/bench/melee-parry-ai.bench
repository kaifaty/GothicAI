wait 34
pin off
# Move the opponent into the open field, clear of the fixture's signpost.
turn 180
pin BDT_1013_BANDIT_L 160 0 0
wait 300
pin off
immortal BDT_1013_BANDIT_L on
still player on
seed 73013
fight BDT_1013_BANDIT_L player
wait 800
