# The quiver on the right hip (graphics/mesh/quiver, docs/manual-aim.md): the hero and an npc bowman in five
# armours (the bandit's thing on the hip, the militia's flaps, the fire mage's robe, the paladin's plate, light
# leather): the bow drawn standing (S_BOWRUN), aiming, aiming crouched, running with the bow (S_BOWRUNL),
# walking and sneaking with the bow put away; a two-hander on the back with the bow; 0, 1, 5, 20, 50 arrows.
# From in front on the right and from the right side. slowmo 2: a row of metrics.csv is 1/60 s of the game
# (qv_armor, qv_leg: cm the armour and the legs go into the quiver; qv_arrows; qv_mx..qv_mz: the mouth in the
# pelvis bone's frame); a clip to 60 fps in real time: ffmpeg -i x.mp4 -vf setpts=0.5*PTS -r 60 x60.mp4.
# The quiver's body: OPENGOTHIC_CONTENT with ITRW_QUIVER (scripts/content/mesh3d/quiver_stub.py)
cheat god
set time 12 0
view clean
goto NW_XARDAS_TOWER_VALLEY_091   # flat open ground
face -106                         # a rock behind, open in front
wait 500
manual on
equip ItRw_Bow_L_01
arrows player 20
cam look 95
slowmo 2
tap bow
wait 1500


# --- the hero in ITAR_BDT_H
equip ITAR_BDT_H
arrows player 20
wait 400
cam follow 210 105 -45
wait 200
rec hero_bdt_stand_fr
wait 1000
stop
cam follow 210 105 -90
wait 200
rec hero_bdt_stand_side
wait 1000
stop
cam follow 210 105 -45
press action
wait 900
rec hero_bdt_aim_fr
wait 1000
stop
tap sneak
wait 900
rec hero_bdt_crouch_fr
wait 1000
stop
tap sneak
wait 600
release action
wait 1200
arrows player 20
cam follow 210 105 -90
press action
wait 900
rec hero_bdt_aim_side
wait 1000
stop
tap sneak
wait 900
rec hero_bdt_crouch_side
wait 1000
stop
tap sneak
wait 600
release action
wait 1200
arrows player 20
cam follow 210 105 -45
hold forward 2000
wait 500
rec hero_bdt_bowrun_fr
wait 1200
stop
release all
goto NW_XARDAS_TOWER_VALLEY_091
face -106
wait 400
cam follow 210 105 -90
hold forward 2000
wait 500
rec hero_bdt_bowrun_side
wait 1200
stop
release all
goto NW_XARDAS_TOWER_VALLEY_091
face -106
wait 400
tap bow
wait 1500
walkmode walk
cam follow 210 105 -45
hold forward 2200
wait 700
rec hero_bdt_walk_fr
wait 1200
stop
release all
goto NW_XARDAS_TOWER_VALLEY_091
face -106
wait 400
cam follow 210 105 -90
hold forward 2200
wait 700
rec hero_bdt_walk_side
wait 1200
stop
release all
goto NW_XARDAS_TOWER_VALLEY_091
face -106
wait 400
walkmode sneak
cam follow 210 105 -45
hold forward 2200
wait 700
rec hero_bdt_sneak_fr
wait 1200
stop
release all
goto NW_XARDAS_TOWER_VALLEY_091
face -106
wait 400
cam follow 210 105 -90
hold forward 2200
wait 700
rec hero_bdt_sneak_side
wait 1200
stop
release all
goto NW_XARDAS_TOWER_VALLEY_091
face -106
wait 400
walkmode run
tap bow
wait 1500

