# --- an npc bowman, the same poses: it stands frozen in front of the hero, plays them on the spot
arrows player 20
insert BAU_904_BAUER
wait 300
immortal BAU_904_BAUER on
npcequip BAU_904_BAUER ItRw_Bow_L_01
arrows BAU_904_BAUER 20
pin BAU_904_BAUER 700 0 0
watch BAU_904_BAUER
wait 500

# --- the npc in ITAR_BDT_H
npcequip BAU_904_BAUER ITAR_BDT_H
arrows BAU_904_BAUER 20
archer BAU_904_BAUER at player
wait 2500
cam follow 210 105 -45
wait 200
rec npc_bdt_aim_fr
wait 1000
stop
cam follow 210 105 -90
wait 200
rec npc_bdt_aim_side
wait 1000
stop
archer off
freeze BAU_904_BAUER
ani BAU_904_BAUER S_BOWRUN force
wait 600
