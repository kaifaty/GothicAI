# --- an npc bowman, the same: it stands in front of the hero (pinned), plays the moves on the spot; the aim and
# the shot by hand at the sheep
arrows player 20
insert BAU_904_BAUER
wait 300
immortal BAU_904_BAUER on
npcequip BAU_904_BAUER ItRw_Bow_L_01
arrows BAU_904_BAUER 20
pin BAU_904_BAUER 700 0 0
watch BAU_904_BAUER
wait 500

# --- the npc in ITAR_Leather_L
npcequip BAU_904_BAUER ITAR_Leather_L
arrows BAU_904_BAUER 20
archer BAU_904_BAUER at SHEEP
wait 2000
cam follow 220 105 -45
wait 200
rec npc_lea_aim_fr
wait 2500
stop
