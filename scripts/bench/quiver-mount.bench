wait 200
rec npc_bdt_walk_fr
wait 1000
stop
cam follow 210 105 -90
wait 200
rec npc_bdt_walk_side
wait 1000
stop
ani BAU_904_BAUER S_SNEAKL force
wait 600
cam follow 210 105 -45
wait 200
rec npc_bdt_sneak_fr
wait 1000
stop
cam follow 210 105 -90
wait 200
rec npc_bdt_sneak_side
