# Four spruces A on the hill west of Akil's farm, in the set made by fir_set.py eye-threshold.
# Left to right: control, k=4, k=8, k=16. The camera aims across the row at depression 20 degrees.
# Log-spaced segments run from 23 to 400 m and back. The 56-48 px band is slower so the
# 50 px mesh level and 49 px impostor switches are separated in both directions, including hysteresis.
# Keep each wait equal to its cam fly duration. The marks timestamp the route for fir_eye_frames.py.
# OPENGOTHIC_CONTENT=<set> OPENGOTHIC_MESH_LEVELS=1 OPENGOTHIC_IMPOSTORS=1 TEMPEST_WINDOW_SIZE=1920x1080 \
#   BENCH_HOST=ryzen RYZEN_BENCH_WINDOW=1 RYZEN_LOCK_WAIT=1200 scripts/bench.sh fir-eye-threshold <output>
# @timeout 1200
seed 73013
cheat god
overlay off
ui off
view full
set time 12 0

goto pos 42700 3517 -2230
clear 3000
streaming wait
grass wait
cam at 45769.34 7789.28 -1423.37 47854.16 7003.70 -864.74
wait 5000
rec fir-eye-threshold
wait 1000

