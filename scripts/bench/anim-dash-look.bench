# Our own back dash (step 6 of the melee port, reports/Свои анимации для боя.md): the hero in the 1H stance plays
# the finished dash variants from content, then the original T_1HPARADEJUMPB, side and front, at 1x and slowed 4x.
# The dash comes from OPENGOTHIC_CONTENT made by scripts/content/anim/content_pack.py (names T_1HDASHB_A, _B).
# The look is judged by Claude from the clips; anim_pop in metrics.csv at the switches.
# WORLD=NEWWORLD.ZEN OPENGOTHIC_CONTENT=/abs/content
seed 73013
cheat god
set time 12 0
release all
overlay off
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
wait 500
watch player
clear 3000
corner right go 0
melee-shadow setup 1h
wait 600
melee-shadow weapon 1h
wait 1500
pin WOLF 5000 90 0
wait 34
pin off
pin WOLF 5000 -90 0
wait 34
pin off
anims

cam follow 420 100 90
wait 800
rec dash-a-side
ani player T_1HDASHB_A
wait 1500
ani player T_1HDASHB_B
wait 1500
ani player T_1HPARADEJUMPB
wait 1500
stop

cam follow 420 100 0
wait 800
rec dash-a-front
ani player T_1HDASHB_A
wait 1500
stop

cam follow 420 100 90
slowmo 4
wait 800
rec dash-slow-side
ani player T_1HDASHB_A
wait 1200
ani player T_1HPARADEJUMPB
wait 1200
stop
slowmo 1
