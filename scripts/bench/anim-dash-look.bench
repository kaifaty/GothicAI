# Our own back dash (step 6 of the melee port, reports/Свои анимации для боя.md): the hero with a one-hander drawn
# in the HUMANS_1HST2 overlay plays three finished dash candidates from content, then the original
# T_1HPARADEJUMPB; each from the same spot on an open field, side at 1x and slowed 4x, front at 1x.
# The candidates come from OPENGOTHIC_CONTENT made by scripts/content/anim/content_pack.py (T_1HDASHB_1.._3 in
# HUMANS_1HST2.MSB). The look is judged by Claude from the clips; anim_pop in metrics.csv at the switches.
# After a goto the hero needs ~2 s on the ground before `ani` is accepted. After an `ani` the hero idles in S_1H
# (sword down), so each take re-arms first: the move must start from the combat stance S_1HRUN.
# WORLD=NEWWORLD.ZEN OPENGOTHIC_CONTENT=/abs/content
seed 73013
cheat god
set time 12 0
release all
overlay off
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
wait 500
watch player
clear 3000
melee-shadow weapon 1h
# the talent set by the fixture does not put its stance overlay on; bladepath puts it on (no names after it)
bladepath HUMANS_1HST2.MDS
wait 1500
anims
animinfo T_1HDASHB_1 T_1HDASHB_2 T_1HDASHB_3 T_1HPARADEJUMPB S_1HRUN

cam follow 380 110 270
wait 800
rec dash1-side
ani player T_1HDASHB_1
wait 1300
stop
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
melee-shadow weapon 1h
bladepath HUMANS_1HST2.MDS
wait 2000
rec dash2-side
ani player T_1HDASHB_2
wait 1300
stop
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
melee-shadow weapon 1h
bladepath HUMANS_1HST2.MDS
wait 2000
rec dash3-side
ani player T_1HDASHB_3
wait 1300
stop
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
melee-shadow weapon 1h
bladepath HUMANS_1HST2.MDS
wait 2000
rec jumpb-side
ani player T_1HPARADEJUMPB
wait 1300
stop

slowmo 4
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
melee-shadow weapon 1h
bladepath HUMANS_1HST2.MDS
wait 2000
rec dash1-slow
ani player T_1HDASHB_1
wait 1000
stop
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
melee-shadow weapon 1h
bladepath HUMANS_1HST2.MDS
wait 2000
rec dash3-slow
ani player T_1HDASHB_3
wait 1000
stop
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
melee-shadow weapon 1h
bladepath HUMANS_1HST2.MDS
wait 2000
rec jumpb-slow
ani player T_1HPARADEJUMPB
wait 1000
stop
slowmo 1

cam follow 420 120 0
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
melee-shadow weapon 1h
bladepath HUMANS_1HST2.MDS
wait 2000
rec dash1-front
ani player T_1HDASHB_1
wait 1300
stop
