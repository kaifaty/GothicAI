# Onar's north field from above (reports/content/2026-11-19-crop-fields/top.md): what the top of the rye reads as.
# Two cameras of crop-onar-alive.bench for the pairs, three over a strip of rye and one beside it (stalk.md).
#   TEMPEST_WINDOW_SIZE=2560x1440 OPENGOTHIC_CONTENT=<set> scripts/bench.sh crop-onar-top <out>
# @timeout 600
seed 73013
cheat god
set time 12 0
overlay off
ui off
view full
walkmode walk
watch player
goto pos 57094 1850 -11100
# from 30 m over the south side: both plots (crop-onar-alive's `over`)
cam at 61400 5100 -12500 61400 2100 -7600
clear 3000
wait 15000
grass wait
wait 2000
shot over
wait 300
# from 6 m over the west corner across the plot (crop-onar-alive's `corner`)
cam at 55400 2300 -10000 59000 2050 -8000
wait 6000
shot corner
wait 300
# The three below stand over the second strip of rye of the set built with seed 7, where it is whole for 6 m round
# (59060 2150 -9300; the strip runs along 0.05 0 -1): the pairs with the concepts onar-top-{high,plan,near}-1
# from 10 m, steeply down along the strip
cam at 58937 3016 -8815 59060 2250 -9300
wait 6000
shot high
wait 300
# from 35 m: the strips as a plan
cam at 58765 5440 -8137 59060 2150 -9300
wait 6000
shot plan
wait 300
# from 3 m, down at 45 degrees
cam at 59008 2462 -9094 59060 2250 -9300
wait 6000
shot near
wait 300
# from a man's height beside the strip, along its wall
cam at 59460 2330 -8600 59330 2240 -9900
wait 6000
shot eye
wait 300
# clip: a gust over the strip of rye, from 10 m (the camera of `high`)
cam at 58937 3016 -8815 59060 2250 -9300
foliage wait-gust 4000 -9300
rec gust-high
wait 12000
stop
wait 500
