# Native NEWWORLD, OPENGOTHIC_CLUSTER_LOD=1 OPENGOTHIC_CLUSTER_LOD_PX=8.
# Force L0 for the first mask so both comparisons fit in one launch.
world-check NEWWORLD.ZEN
seed 73013
cheat god
set time 12 0
overlay off
ui off
view full
goto pos 36500 3900 -7577
cam at 20000 19000 -35000 41250 3350 650
streaming wait
cluster-lod mask on
cluster-lod base
rec mask-base
cam fly 13000 34000 -50000 41250 3350 650 8000
wait 8000
stop
cam at 20000 19000 -35000 41250 3350 650
streaming wait
cluster-lod normal
rec mask-cut
cam fly 13000 34000 -50000 41250 3350 650 8000
wait 8000
stop
cluster-lod mask off

cluster-lod levels
cam at 20000 19000 -35000 41250 3350 650
streaming wait
shot levels-near
wait 100
cam at 13000 34000 -50000 41250 3350 650
streaming wait
shot levels-far
wait 100
cluster-lod normal

cadence normal
wait 2000
perf sample perf-cluster-lod/view-1-px8
wait 4000
perf stop
cadence wait
