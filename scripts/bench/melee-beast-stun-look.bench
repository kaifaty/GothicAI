watch player
clear 3000
insert Shadowbeast
put SHADOWBEAST 260 0
stats npc SHADOWBEAST hp 100000 hpmax 100000
wait 400
fight SHADOWBEAST player
wait 200
freeze SHADOWBEAST
freeze SHADOWBEAST
state SHADOWBEAST ZS_MM_ATTACK NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
freeze SHADOWBEAST off
cam two SHADOWBEAST 650 60 1
wait 1200
rec shadow-stun
stun SHADOWBEAST posture
shot shadow-000
wait 150
shot shadow-150
wait 200
shot shadow-350
wait 250
shot shadow-600
wait 300
shot shadow-900
wait 300
