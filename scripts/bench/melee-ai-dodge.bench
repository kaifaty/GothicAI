# Native 1H dodge replacement: run unchanged with MELEE_AI_DODGE=1 and 0.
# WORLD=NEWWORLD.ZEN OPENGOTHIC_BODY_TRACE=1 MELEE_DODGE=1 MELEE_STAMINA=1 MELEE_POSTURE=0 TIMEOUT=900
# OPENGOTHIC_CONTENT=/Users/kaifat/.local/share/gothic-ai/content-staging/anim-strikes
# Ordinary running attacks use T_1HATTACKMOVE; NPC animations and hit reactions run normally.
# Prime one native fight per case. Reposition only the hero, preserving the native FAI queue and weapon stance.
# The master gets 40 swings, the novice and controls 24. Trace stamina_spend counts actual accepted attacks.
# ai_dodge carries swing age/contact prediction; dodge_invulnerable and hit_attempt record actual blade contacts.
seed 73013
set time 12 0
release all
overlay off
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
wait 500
watch player
clear 3000
corner right go 0
melee-shadow setup 1h
stats hp 1000000 hpmax 1000000 str 100 1h 100 talent auto
wait 600
melee-shadow target 2
wait 600
put WOLF 5000 90
put WOLF 5000 -90
turn 180
immortal player on
still player on
immortal BDT_1013_BANDIT_L on
wait 2000

