# Native heavy-armour 1H barges against the hero's real parade. Run MELEE_AI_BARGE=1 and 0.
# WORLD=NEWWORLD.ZEN OPENGOTHIC_BODY_TRACE=1 MELEE_BARGE=1 MELEE_DODGE=1 MELEE_STAMINA=1
# MELEE_POSTURE=0 MELEE_STAGGER=1 MELEE_PARRY=1 MELEE_AI_CHARGE=0 MELEE_AI_DODGE=0 MELEE_AI_RIPOSTE=0 TIMEOUT=300
# OPENGOTHIC_CONTENT=/Users/kaifat/.local/share/gothic-ai/content-staging/anim-strikes
# ai_barge_roll records parade/guarded; barge_contact and stun_start record the ordinary result/1000 ms.
# Repeated native fights retain the NPC's special cooldown. ai_special_end -> next start must be >=6000 ms.
seed 73013
set time 12 0
release all
overlay off
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
wait 500
watch player
clear 3000
corner right go 0
melee-shadow setup 1h
stats hp 1000000 hpmax 1000000 str 100 1h 100 talent auto
wait 600
melee-shadow target 2
wait 600
put WOLF 5000 90
put WOLF 5000 -90
turn 180
melee-shadow controls g2
immortal player on
still player off
stats npc BDT_1013_BANDIT_L hpmax 1000000 hp 1000000 str 100 1h 100 talent auto
immortal BDT_1013_BANDIT_L on
npcequip BDT_1013_BANDIT_L ITAR_PAL_H
put BDT_1013_BANDIT_L 150 0
wait 2000

# (a,c) Heavy armour, twelve block opportunities 1800 ms apart, including attempts during cooldown.
rec a-heavy-cooldown novideo
mark a-heavy-cooldown
release all
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
press parade
wait 100
fight BDT_1013_BANDIT_L player
wait 1700
release all
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
press parade
wait 100
fight BDT_1013_BANDIT_L player
wait 1700
release all
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
press parade
wait 100
fight BDT_1013_BANDIT_L player
wait 1700
release all
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
press parade
wait 100
fight BDT_1013_BANDIT_L player
wait 1700
release all
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
press parade
wait 100
fight BDT_1013_BANDIT_L player
wait 1700
release all
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
press parade
wait 100
fight BDT_1013_BANDIT_L player
wait 1700
release all
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
press parade
wait 100
fight BDT_1013_BANDIT_L player
wait 1700
release all
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
press parade
wait 100
fight BDT_1013_BANDIT_L player
wait 1700
release all
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
press parade
wait 100
fight BDT_1013_BANDIT_L player
wait 1700
release all
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
press parade
wait 100
fight BDT_1013_BANDIT_L player
wait 1700
release all
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
press parade
wait 100
fight BDT_1013_BANDIT_L player
wait 1700
release all
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
press parade
wait 100
fight BDT_1013_BANDIT_L player
wait 1700
release all
hp player
watch BDT_1013_BANDIT_L
anims
watch player
freeze BDT_1013_BANDIT_L
stop shadow
wait 8000

# (b) The same native master in medium armour cannot barge against the same block.
npcequip BDT_1013_BANDIT_L ITAR_MIL_M
melee-shadow bandit 1h
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
wait 1000
rec b-medium novideo
mark b-medium
press parade
wait 100
fight BDT_1013_BANDIT_L player
wait 12000
release all
hp player
watch BDT_1013_BANDIT_L
anims
watch player
freeze BDT_1013_BANDIT_L
stop shadow
wait 8000

# Runtime switch: use heavy armour and restore the original setting afterwards.
npcequip BDT_1013_BANDIT_L ITAR_PAL_H
melee-shadow bandit 1h
put BDT_1013_BANDIT_L 150 0
face npc BDT_1013_BANDIT_L
wait 1000
toggle melee_ai_barge
rec toggle-inverted novideo
mark toggle-inverted
press parade
wait 100
fight BDT_1013_BANDIT_L player
wait 8000
release all
hp player
freeze BDT_1013_BANDIT_L
stop shadow
toggle melee_ai_barge
