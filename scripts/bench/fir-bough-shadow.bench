# The shadow ladder of the three spruces of the row of fir-bough-lod.bench (`fir_set.py bough --labels`): the camera
# stands on that bench's view direction (20 degrees down, square to the row) through the middle spruce, 9 m from
# its middle, backs away to 70 m and returns. By the distance to the camera, as the engine measures it, the outer
# spruces pass 1015 -> 210 -> 1015 px of height (1006 and 209 px for the third) and the middle one 1659 -> 213 -> 1659:
# through the bands of the shadow thresholds 800, 400 and 240 px (914 -> 751, 457 -> 376, 274 -> 225 px) and of the
# wood's 400 px. The first leg takes 6.2 s and the following legs 4.8 s, about 3.8 % of the middle spruce's height a second, at
# most 4.3 (fir-bough-near.bench: 3.7 to 3.9, at most 4.4). It looks 60 cm below the middle; below 14 m the frame
# cuts the tops of the crowns, and the ground with the shadows stays in it. Keep each wait equal to its cam fly.
# The run is offscreen, the stand's default: a window that another one covers on Ryzen draws a frame a second.
# BASE=~/.local/share/gothic-ai/remaster/trees-fir/bough-early
# RYZEN_TASK="$(ssh ryzen 'printenv HOME')/gothic-ai/tree-shadow-near"
# WORLD=NEWWORLD.ZEN OPENGOTHIC_CONTENT="$BASE/content" OPENGOTHIC_TEXTURES= \
#   OPENGOTHIC_TREE_BOUGH_LOD=1 OPENGOTHIC_MESH_LEVELS=1 OPENGOTHIC_IMPOSTORS=1 \
#   OPENGOTHIC_FRAME_PROFILE="$BASE/run-shadow/frameprofile.csv" OPENGOTHIC_BENCH_REALTIME=1 \
#   OPENGOTHIC_BENCH_ENCODER='-c:v h264_nvenc -preset p4 -b:v 24M' TEMPEST_WINDOW_SIZE=1920x1080 \
#   BENCH_HOST=ryzen RYZEN_LOCK_WAIT=1200 RYZEN_MAX=6m \
#   RYZEN_BENCH_ARCHIVE="$RYZEN_TASK/run-shadow-$(date -u +%Y%m%dT%H%M%SZ)" \
#   scripts/bench.sh fir-bough-shadow "$BASE/run-shadow"
# @timeout 600
seed 73013
cheat god
overlay off
ui off
view full
set time 12 0

goto pos 42700 3517 -2230
clear 3000
streaming wait
grass wait
cam at 46888.45 7352.00 -528.23 47705.36 6984.18 -309.34
wait 5000
rec fir-bough-shadow
wait 1000

# Away from the three spruces.
cam fly 46671.40 7433.79 -586.39 47705.36 6984.18 -309.34 6200
mark fir-bough-leg
wait 6200
cam fly 46465.54 7511.36 -641.55 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 46218.71 7604.37 -707.69 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 45922.73 7715.89 -786.99 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 45567.82 7849.63 -882.09 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 45142.25 8009.98 -996.12 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 44631.96 8202.27 -1132.85 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 44020.08 8432.83 -1296.81 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 43286.37 8709.30 -1493.40 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 42406.59 9040.81 -1729.14 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 41351.65 9438.32 -2011.81 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
wait 2000

# Back to them.
cam fly 42406.59 9040.81 -1729.14 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 43286.37 8709.30 -1493.40 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 44020.08 8432.83 -1296.81 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 44631.96 8202.27 -1132.85 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 45142.25 8009.98 -996.12 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 45567.82 7849.63 -882.09 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 45922.73 7715.89 -786.99 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 46218.71 7604.37 -707.69 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 46465.54 7511.36 -641.55 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 46671.40 7433.79 -586.39 47705.36 6984.18 -309.34 4800
mark fir-bough-leg
wait 4800
cam fly 46888.45 7352.00 -528.23 47705.36 6984.18 -309.34 6200
mark fir-bough-leg
wait 6200
mark fir-bough-returned
wait 1000
stop
