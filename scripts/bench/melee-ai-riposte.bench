# Native 1H riposte replacement. Run unchanged with MELEE_AI_RIPOSTE=1 and 0.
# WORLD=NEWWORLD.ZEN OPENGOTHIC_BODY_TRACE=1 MELEE_RIPOSTE=1 MELEE_STAGGER=1 MELEE_PARRY_AI=1 TIMEOUT=300
# OPENGOTHIC_CONTENT=/Users/kaifat/.local/share/gothic-ai/content-staging/anim-strikes
# Metrics only. riposte_start/blade/handover and damage trace provide 400/840 ms and x3/x1.5.
# Pair, where and anims sample roots and clips while movement, attack, dodge, parade and weapon input are pressed.
seed 73013
set time 12 0
release all
overlay off
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
wait 500
watch player
clear 3000
corner right go 0
melee-shadow setup 1h
stats hp 1000000 hpmax 1000000 str 100 1h 100 talent auto
wait 600
melee-shadow target 2
wait 600
put WOLF 5000 90
put WOLF 5000 -90
turn 180
wait 2000
stats npc BDT_1013_BANDIT_L hpmax 100000 hp 100000 str 60 1h 100 talent auto
immortal BDT_1013_BANDIT_L on

# (a) Master attacks the stunned hero; ordinary player input must preserve the paired clip.
put BDT_1013_BANDIT_L 150 0
wait 1000
rec a-hero-talent100 novideo
mark a-hero-talent100
fight BDT_1013_BANDIT_L player
stun player posture
wait 100
pair BDT_1013_BANDIT_L player
where player
anims
press forward
press action
tap dodge
tap parade
tap weapon
wait 320
pair BDT_1013_BANDIT_L player
where player
anims
release all
press left
press action
tap dodge
tap parade
tap weapon
wait 420
pair BDT_1013_BANDIT_L player
where player
anims
release all
wait 1800
hp player
anims
freeze BDT_1013_BANDIT_L
stop shadow
wait 8000

# (b) Talent zero must roll once and keep the ordinary stunned-target x1.5 attack.
melee-shadow weapon 1h
stats npc BDT_1013_BANDIT_L 1h 0 talent auto
put BDT_1013_BANDIT_L 150 0
wait 1000
rec b-hero-talent0 novideo
mark b-hero-talent0
fight BDT_1013_BANDIT_L player
stun player posture
wait 1200
hp player
anims
pair BDT_1013_BANDIT_L player
freeze BDT_1013_BANDIT_L
stop shadow
wait 8000

# (c) A second master joins an existing pair before blade contact. He must wait facing the held hero.
melee-shadow weapon 1h
stats npc BDT_1013_BANDIT_L 1h 100 talent auto
arc BDT_1003_BANDIT_M 1 180 0
npcequip BDT_1003_BANDIT_M ITMW_1H_COMMON_01
stats npc BDT_1003_BANDIT_M hpmax 100000 hp 100000 str 60 1h 100 talent auto
put BDT_1003_BANDIT_M 170 30
melee-shadow bandit 1h BDT_1003_BANDIT_M
put BDT_1013_BANDIT_L 150 0
wait 1000
rec c-two-bandits novideo
mark c-two-bandits
fight BDT_1013_BANDIT_L player
stun player posture
wait 100
fight BDT_1003_BANDIT_M player
wait 320
pair BDT_1013_BANDIT_L player
pair BDT_1003_BANDIT_M player
watch BDT_1003_BANDIT_M
anims
watch player
wait 420
pair BDT_1003_BANDIT_M player
watch BDT_1003_BANDIT_M
anims
watch player
wait 1500
hp player
freeze BDT_1013_BANDIT_L
freeze BDT_1003_BANDIT_M
stop shadow
put BDT_1003_BANDIT_M 5000 90
wait 8000

# (d) The same attacker can pair with a stunned human NPC. A guard faces him across 150 cm.
melee-shadow weapon 1h
put BDT_1013_BANDIT_L 300 0
arc MIL_322_MILIZ 1 150 0
npcequip MIL_322_MILIZ ITMW_1H_COMMON_01
stats npc MIL_322_MILIZ hpmax 100000 hp 100000 str 60 1h 60 talent auto
put MIL_322_MILIZ 150 0
fight MIL_322_MILIZ BDT_1013_BANDIT_L
wait 800
freeze MIL_322_MILIZ
rec d-guard novideo
mark d-guard
fight BDT_1013_BANDIT_L MIL_322_MILIZ
stun MIL_322_MILIZ posture
wait 420
pair BDT_1013_BANDIT_L MIL_322_MILIZ
watch MIL_322_MILIZ
anims
wait 420
anims
wait 1600
hp MIL_322_MILIZ
pair BDT_1013_BANDIT_L MIL_322_MILIZ
freeze BDT_1013_BANDIT_L
freeze MIL_322_MILIZ
stop shadow
watch player
put MIL_322_MILIZ 5000 -90
wait 8000

# Marvin toggle: ON becomes ordinary attack, OFF becomes a paired attack; restore the setting afterwards.
put BDT_1013_BANDIT_L 150 0
wait 1000
toggle melee_ai_riposte
rec toggle-inverted novideo
mark toggle-inverted
fight BDT_1013_BANDIT_L player
stun player posture
wait 2400
hp player
anims
freeze BDT_1013_BANDIT_L
stop shadow
toggle melee_ai_riposte
release all
