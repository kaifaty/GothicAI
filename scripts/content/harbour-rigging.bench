# harbour-rigging: original or a staging set, default game FOV, noon, NPC and effects hidden.
# Generated by remaster.py bench from reports/content/remaster/harbour-rigging/cameras.json; world cm.
cheat god
clear 1000000
set time 12 0
overlay off
view hide animated morph pfx
cam lift off

