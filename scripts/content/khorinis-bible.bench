# Khorinis art bible: districts missing from the survey (lighthouse, gates, temple square).
# Original only; noon, default game FOV, NPCs and effects hidden; world coordinates in cm.
# Run: QUALITY_PILOT_TASK=gothic-ai/remaster-khorinis-bible scripts/content/capture-quality-pilot.sh --capture original DIR
cheat god
clear 1000000
set time 12 0
overlay off
view hide animated morph pfx
cam lift off

# Lighthouse above the trees, sea behind; eye (1500, 4200, 14000), target (-1650, 3500, 16340).
set time 12 0
cam look -2000.000
goto pos -1650.000 5500.000 16340.000
cam world 3924.041 -1300.000 -36.607075
wait 34
cam hold
wait 6000
set time 12 0
shot lighthouse-high
wait 300

# Lighthouse at the door; eye (-35, 2412, 15385), target (-1300, 3200, 16150).
set time 12 0
cam look -2000.000
goto pos -1300.000 5200.000 16150.000
cam world 1478.327 -2788.000 -31.163161
wait 34
cam hold
wait 6000
set time 12 0
shot lighthouse-near
wait 300

