# harbour-motion: two views with the 5 px column stripes, noon; for comparing render settings (QUALITY_PILOT_INI).
# Generated by harbour_motion.py bench from reports/content/remaster/harbour-motion/cameras.json; world cm.
cheat god
clear 1000000
set time 12 0
overlay off
view full
cam lift off

# quay-west: west quay from crane C towards the fishers, 47 m: no lamp posts, braziers at the far end
cam look -2000.000
goto pos -15700.000 2620.000 -7400.000
cam world 14122.323 -2630.000 12.264774
wait 34
cam hold
wait 6000
set time 12 0
shot quay-west
wait 300

# banners: two town banners on the wall towers east of the poor quarter, from the street where both are cloth (22 and 37 m)
cam look -500.000
goto pos 6800.000 2500.000 -6000.000
cam world 1007.895 -2010.000 166.984079
wait 34
cam hold
wait 6000
set time 12 0
shot banners
wait 700
shot banners-b
wait 300
