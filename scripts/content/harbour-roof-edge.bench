# harbour-roof-edge: original or a staging set, default game FOV, noon, NPC and effects hidden.
# Generated by remaster.py bench from reports/content/remaster/harbour-roof-edge/cameras.json; world cm.
cheat god
clear 1000000
set time 12 0
overlay off
view hide animated morph pfx
cam lift off

# front: hut B037 from the street, 6 m, eye 4 m above the ground (roof-holes.bench front)
cam look -634.000
goto pos 3533.000 784.000 -3832.000
cam world 600.051 -500.000 -104.476259
wait 34
cam hold
wait 6000
set time 12 0
shot front
wait 300

# eave-close: eave of B037's front slope from 2.7 m, eye 2.5 m above the ground
cam look -500.000
goto pos 3288.000 664.000 -3805.000
cam world 267.748 -554.000 -113.788668
wait 34
cam hold
wait 6000
set time 12 0
shot eave-close
wait 300

# verge-close: verge of B037's west gable from 3 m
cam look -500.000
goto pos 3100.000 800.000 -3550.000
cam world 291.548 -550.000 -149.036243
wait 34
cam hold
wait 6000
set time 12 0
shot verge-close
wait 300

# huts-east: huts B036 and B035 from the lane, 18 m
