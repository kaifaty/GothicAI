# harbour-crane-deck: original or a staging set, default game FOV, noon, NPC and effects hidden.
# Generated by remaster.py bench from reports/content/remaster/harbour-crane-deck/cameras.json; world cm.
cheat god
clear 1000000
set time 12 0
overlay off
view hide animated morph pfx
cam lift off

# crane-far: crane C on the quay from 17 m, eye 2.3 m above the quay
cam look -670.000
goto pos -750.000 730.000 -3000.000
cam world 1671.077 -500.000 51.072456
wait 34
cam hold
wait 6000
set time 12 0
shot crane-far
wait 300

# deck-mid: crane C's deck from 8 m: the straps and the planks' edge
cam look -690.000
goto pos -750.000 730.000 -3050.000
cam world 813.941 -500.000 -47.489553
wait 34
cam hold
wait 6000
set time 12 0
shot deck-mid
wait 300

# deck-close: the deck's cut corner from 3.5 m: plank ends and the strap bent over the edge
cam look -610.000
goto pos -430.000 650.000 -3120.000
cam world 328.024 -500.000 -52.431408
wait 34
cam hold
wait 6000
set time 12 0
shot deck-close
wait 300

# crane-a: crane A by the paladins' ship from 9 m on the quay path (towards NW_CITY_WAY_TO_SHIP_19)
cam look -526.000
goto pos -8291.000 506.000 -12541.000
cam world 899.983 -500.000 13.827795
wait 34
cam hold
wait 6000
set time 12 0
shot crane-a
wait 300
