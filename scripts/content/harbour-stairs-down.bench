# Down the harbour stairs: walk from the landing, walk from the middle, run from the landing.
cheat god
set time 12 0
overlay off
cam follow 300 90 200
goto pos 8840 590 -4800
face 192
walkmode walk
pos
hold forward 1500
wait 1500
pos
hold forward 1500
wait 1500
pos
release all
goto pos 8560 470 -4850
face 192
pos
hold forward 2000
wait 2000
pos
release all
goto pos 8840 590 -4800
face 192
walkmode run
hold forward 1500
wait 1500
pos
hold forward 1500
wait 1500
pos
release all
