# Harbour quay: one view of each texture, from scripts/content/city-intent.bench (geometry-selected
# inspection cameras), noon, NPCs hidden.
cheat god
set time 12 0
overlay off
view hide animated morph pfx
cam lift off

# NW_CITY_HAFENKAI_MAUER_01.TGA | NW_CITY_WAY_TO_SHIP_10 | upper quay wall face
# Camera: Inspection reframe: hero anchored 20 m above the surface to avoid teleport collision; camera eye and target kept in the scene.
view hide animated morph pfx
cam look -2000.000
goto pos -6360 1526 -9360
cam world 280.264 -1931.363 -9.679
wait 34
cam hold
wait 6000
shot nw_city_hafenkai_mauer_01
wait 300

