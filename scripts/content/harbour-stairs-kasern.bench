# harbour-stairs-kasern: original or a staging set, default game FOV, noon, NPC and effects hidden.
# Generated by remaster.py bench from reports/content/remaster/harbour-stairs-kasern/cameras.json; world cm.
cheat god
clear 1000000
set time 12 0
overlay off
view hide animated morph pfx
cam lift off

# stairs-yard: both flights from the yard at the foot, 12 m, eye 2 m above the yard
cam look -500.000
goto pos 1900.000 1020.000 5400.000
cam world 1252.996 -520.000 -118.610460
wait 34
cam hold
wait 6000
set time 12 0
shot stairs-yard
wait 300

# stairs-close: the lower flight from 5 m, eye at the foot of it
cam look -500.000
goto pos 1800.000 950.000 5200.000
cam world 514.782 -530.000 -119.054604
wait 34
cam hold
wait 6000
set time 12 0
shot stairs-close
wait 300

# stairs-landing: the upper flight from the landing, 5.5 m
cam look -550.000
goto pos 2100.000 1200.000 5700.000
cam world 565.685 -500.000 -135.000000
wait 34
cam hold
wait 6000
set time 12 0
shot stairs-landing
wait 300
