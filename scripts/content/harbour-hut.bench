# B037 HUT_05: original resources, default game FOV, noon.
# Fixed cameras measured from the selected hut geometry; world units are cm.
cheat god
clear 1000000
set time 12 0
overlay off
view hide animated morph pfx
cam lift off

# front: 6 m; eye = ground + 400 cm.
cam look -800.000
goto pos 3533.163 950.000 -3831.682
cam world 600.000 -666.515 -104.500000
wait 34
cam hold
wait 6000
shot front
wait 300

# gable: 5 m; eye = ground + 170 cm.
cam look -800.000
goto pos 3129.378 950.000 -3316.161
cam world 500.000 -942.515 165.500000
wait 34
cam hold
wait 6000
shot gable
wait 300

# three-quarter: 13 m; eye = ground + 170 cm.
cam look -800.000
goto pos 3632.814 950.000 -3446.359
cam world 1300.000 -968.195 -149.500000
wait 34
cam hold
wait 6000
shot three-quarter
wait 300

# window: 4 m; eye = ground + 170 cm.
cam look -935.000
goto pos 3224.608 950.000 -3746.719
cam world 400.000 -897.672 -104.500000
wait 34
cam hold
wait 6000
shot window
wait 300

# planks: 3 m; eye = ground + 170 cm.
cam look -920.000
goto pos 3524.734 950.000 -3824.337
cam world 300.000 -896.515 -104.500000
wait 34
cam hold
wait 6000
shot planks
wait 300

# gable-close: 4 m; eye = ground + 170 cm.
cam look -655.000
goto pos 3129.378 950.000 -3316.161
cam world 400.000 -921.178 165.500000
wait 34
cam hold
wait 6000
shot gable-close
wait 300
