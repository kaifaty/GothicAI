# harbour-motion: a staging set, default game FOV, midnight, NPC cleared, effects and lamps drawn.
# Generated by harbour_motion.py bench from reports/content/remaster/harbour-motion/cameras.json; world cm.
cheat god
clear 1000000
set time 0 0
overlay off
view full
cam lift off

# huts: poor huts from the lane, 15 m: the hut whose hearth burns under a hole in its roof
cam look -2000.000
goto pos 8393.859 3171.685 -3930.247
cam world 5884.484 -3171.685 -178.288484
wait 34
cam hold
wait 6000
set time 0 0
shot huts-night
wait 700
shot huts-night-b
wait 300

# huts-north: the hut with the large hearth from the north, 11 m: hole in its roof above the fire
cam look -2000.000
goto pos 2374.928 3696.858 -7129.823
cam world 5763.817 -3666.858 83.774171
wait 34
cam hold
wait 6000
set time 0 0
shot huts-north-night
wait 700
shot huts-north-night-b
wait 300

# overhead: the district from above crane C, as the art bible's overview: roofs, plaza, lamp posts
