# Local settings for the ASR and TTS services: copy to .env (ignored by git) and fill in.
# The services read the nearest .env at or above the current directory; real environment variables win.

# Self-hosted models on the GPU server (asr-service/deploy, tts-service/deploy)
GOTHIC_VOXTRAL_URL=http://127.0.0.1:47830
GOTHIC_VOXCPM_URL=ws://127.0.0.1:47831
# NPC decision service (decider-service/deploy): the AI server's npc planner is off without it
# GOTHIC_DECIDER_URL=ws://127.0.0.1:47832
# Quick model of fights (server/deploy/gemma): npc lines in a fight at once. The AI server looks for it on the
# decider's host by default; this is the address scripts/deploy-gpu.sh makes it listen on
# GOTHIC_QUICK_LLM_URL=http://127.0.0.1:47834/v1
# Neural body of fights (body-service/deploy): P30 drives a one-handed npc fighting the hero; off without it
# GOTHIC_BODY_URL=tcp://127.0.0.1:47835

# GPU server for scripts/deploy-gpu.sh: its ssh destination. The models there listen where the two URLs
# above point; GPU_<NAME>=value lines reach the server as <NAME>=value. API keys below are never sent.
# GOTHIC_GPU_SSH=gpu-host

# Cloud providers
INWORLD_API_KEY=
OPENAI_API_KEY=

# Provider chains (defaults shown)
# GOTHIC_ASR_PROVIDER=voxtral
# GOTHIC_ASR_FALLBACK=chatgpt
# GOTHIC_TTS_PROVIDER=inworld
# GOTHIC_TTS_FALLBACK=none

# Signing for the launcher app (scripts/build-launcher.sh); `security find-identity -v -p codesigning`
# GOTHIC_SIGNING_IDENTITY="Apple Development: Your Name"
