cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/EngineLayerGuard.cmake")
include("${PLATFORM_INPUTS}")
engine_layer_guard_read_rules("${PLATFORM_RULES}" patterns layers regexes)
file(READ "${PLATFORM_MAP}" content)
# GNU ld: archive.a(member.cpp.o); Apple ld: archive.a[N](member.cpp.o).
# Both list loaded members, including ones whose sections are subsequently discarded.
string(REGEX MATCHALL "gothic-(base|video)-runtime\\.a(\\[[0-9]+\\])?\\([^()\n]+\\)" loaded "${content}")
list(REMOVE_DUPLICATES loaded)
if(NOT loaded)
  message(FATAL_ERROR "engine-platform-link: no mixed runtime objects found in ${PLATFORM_MAP}; unsupported or incomplete map")
endif()
set(count 0)
foreach(object IN LISTS loaded)
  string(REGEX MATCH "^(gothic-(base|video)-runtime)\\.a(\\[[0-9]+\\])?\\(([^()]+)\\)$" match "${object}")
  set(runtime "${CMAKE_MATCH_1}")
  get_filename_component(member "${CMAKE_MATCH_4}" NAME)
  set(found FALSE)
  foreach(entry IN LISTS PLATFORM_MEMBERS)
    string(REPLACE "|" ";" fields "${entry}")
    list(GET fields 0 archive)
    list(GET fields 1 name)
    if(NOT archive STREQUAL runtime OR NOT name STREQUAL member)
      continue()
    endif()
    set(found TRUE)
    list(GET fields 2 source)
    engine_layer_guard_layer_of("${source}" "${regexes}" "${layers}" layer)
    if(NOT layer STREQUAL "platform")
      message(FATAL_ERROR "engine-platform-link: ${runtime}(${member}) from ${source} belongs to ${layer}, not platform")
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "engine-platform-link: unknown mixed runtime object ${object}")
  endif()
  math(EXPR count "${count} + 1")
endforeach()
message(STATUS "engine-platform-link: ${count} mixed runtime objects checked, all platform")
