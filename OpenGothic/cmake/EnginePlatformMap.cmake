cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/EngineLayerGuard.cmake")
include("${PLATFORM_INPUTS}")
# The program whose map this is, and the layers its mixed runtime objects may come from, separated by commas
# (a command line of add_custom_command would split a ;-list into arguments).
if(NOT DEFINED PLATFORM_TARGET)
  set(PLATFORM_TARGET engine-platform-link)
endif()
if(NOT DEFINED PLATFORM_LAYERS)
  set(PLATFORM_LAYERS platform)
endif()
string(REPLACE "," " or " allowed "${PLATFORM_LAYERS}")
string(REPLACE "," ";" PLATFORM_LAYERS "${PLATFORM_LAYERS}")
engine_layer_guard_read_rules("${PLATFORM_RULES}" patterns layers regexes)
file(READ "${PLATFORM_MAP}" content)
# GNU ld: archive.a(member.cpp.o); Apple ld: archive.a[N](member.cpp.o).
# Both list loaded members, including ones whose sections are subsequently discarded.
string(REGEX MATCHALL "gothic-(base|video)-runtime\\.a(\\[[0-9]+\\])?\\([^()\n]+\\)" loaded "${content}")
list(REMOVE_DUPLICATES loaded)
if(NOT loaded)
  message(FATAL_ERROR "${PLATFORM_TARGET}: no mixed runtime objects found in ${PLATFORM_MAP}; unsupported or incomplete map")
endif()
set(count 0)
foreach(object IN LISTS loaded)
  string(REGEX MATCH "^(gothic-(base|video)-runtime)\\.a(\\[[0-9]+\\])?\\(([^()]+)\\)$" match "${object}")
  set(runtime "${CMAKE_MATCH_1}")
  get_filename_component(member "${CMAKE_MATCH_4}" NAME)
  set(found FALSE)
  foreach(entry IN LISTS PLATFORM_MEMBERS)
    string(REPLACE "|" ";" fields "${entry}")
    list(GET fields 0 archive)
    list(GET fields 1 name)
    if(NOT archive STREQUAL runtime OR NOT name STREQUAL member)
      continue()
    endif()
    set(found TRUE)
    list(GET fields 2 source)
    engine_layer_guard_layer_of("${source}" "${regexes}" "${layers}" layer)
    if(NOT layer IN_LIST PLATFORM_LAYERS)
      message(FATAL_ERROR "${PLATFORM_TARGET}: ${runtime}(${member}) from ${source} belongs to ${layer}, not ${allowed}")
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "${PLATFORM_TARGET}: unknown mixed runtime object ${object}")
  endif()
  math(EXPR count "${count} + 1")
endforeach()
message(STATUS "${PLATFORM_TARGET}: ${count} mixed runtime objects checked, all ${allowed}")
