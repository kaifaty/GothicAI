function(npc_snapshot_fields root npc_output item_output)
  # Derive the complete native field list from the declarations, rather than maintaining a
  # snapshot whitelist. Reconfiguration after an NpcRecord/ItemRecord field addition makes old records fail.
  set(ITEM_RECORD "${root}/common/world/records/itemrecord.h")
  set(NPC_RECORD "${root}/common/world/records/npcrecord.h")
  file(READ "${ITEM_RECORD}" ITEM_RECORD_TEXT)
  file(READ "${NPC_RECORD}" NPC_RECORD_TEXT)
  file(READ "${root}/common/daedalus/classes.cpp" NPC_BINDINGS)
  set(NPC_FIELDS "// Generated from every NpcRecord/ItemRecord field declaration.\n")
  foreach(NATIVE INpc IItem)
    if(NATIVE STREQUAL "INpc")
      set(RECORD_NAME NpcRecord)
      set(RECORD_TEXT "${NPC_RECORD_TEXT}")
    else()
      set(RECORD_NAME ItemRecord)
      set(RECORD_TEXT "${ITEM_RECORD_TEXT}")
    endif()
    string(FIND "${RECORD_TEXT}" "struct ${RECORD_NAME} {" RECORD_BEGIN)
    if(RECORD_BEGIN LESS 0)
      message(FATAL_ERROR "NPC snapshot: cannot find ${RECORD_NAME}")
    endif()
    string(LENGTH "struct ${RECORD_NAME} {" RECORD_PREFIX_LENGTH)
    math(EXPR RECORD_BEGIN "${RECORD_BEGIN} + ${RECORD_PREFIX_LENGTH}")
    string(SUBSTRING "${RECORD_TEXT}" ${RECORD_BEGIN} -1 RECORD_TAIL)
    string(REGEX MATCH "\n[ \t]*\\};[ \t]*(\n|$)" RECORD_END "${RECORD_TAIL}")
    if(NOT RECORD_END)
      message(FATAL_ERROR "NPC snapshot: missing standalone closing }; for ${RECORD_NAME}")
    endif()
    string(FIND "${RECORD_TAIL}" "${RECORD_END}" RECORD_END_BEGIN)
    string(FIND "${RECORD_END}" "}" RECORD_CLOSING_SPACE)
    math(EXPR RECORD_BODY_LENGTH "${RECORD_END_BEGIN} + ${RECORD_CLOSING_SPACE}")
    string(SUBSTRING "${RECORD_TAIL}" 0 ${RECORD_BODY_LENGTH} CLASS_BODY)
    # Validate declarations independently of the visitor regex: unsupported syntax must fail closed.
    string(REGEX REPLACE "//[^\n]*" "" DATA_BODY "${CLASS_BODY}")
    string(REGEX REPLACE "\n[ \t]*using[ \t]+[A-Za-z0-9_]+[ \t]*=[ \t]*[A-Za-z0-9_:]+[ \t]*;" "\n" DATA_BODY "${DATA_BODY}")
    string(REGEX REPLACE "\n[ \t]*static[ \t]+constexpr[ \t]+[A-Za-z0-9_:]+[ \t]+[A-Za-z0-9_]+[ \t]*=[ \t\n]*[A-Za-z0-9_:]+[ \t]*;" "\n" DATA_BODY "${DATA_BODY}")
    string(REGEX REPLACE "\n[ \t]*[A-Za-z0-9_:]+[ \t]+[A-Za-z0-9_]+(\\[[A-Za-z0-9_:]+\\])?;" "\n" UNCOVERED "${DATA_BODY}")
    string(STRIP "${UNCOVERED}" UNCOVERED)
    if(NOT UNCOVERED STREQUAL "")
      message(FATAL_ERROR "NPC snapshot: unsupported ${RECORD_NAME} declaration: ${UNCOVERED}")
    endif()
    string(REGEX REPLACE "[^;]" "" FIELD_ENDS "${DATA_BODY}")
    string(LENGTH "${FIELD_ENDS}" FIELD_COUNT)
    # Keep the pre-move schema spelling: the owning base is an implementation detail.
    # Function retains the old func annotation without depending on the VM header.
    string(REPLACE "\t\tusing Function = int32_t;\n" "" CLASS_BODY "${CLASS_BODY}")
    string(REGEX REPLACE "\n\t\t([A-Za-z0-9_:]+) ([A-Za-z0-9_]+)(\\[[A-Za-z0-9_:]+\\])?;" "\n\t\tvar \\1 \\2\\3;" CLASS_BODY "${CLASS_BODY}")
    string(REPLACE "std::string" "string" CLASS_BODY "${CLASS_BODY}")
    string(REPLACE "Function" "func" CLASS_BODY "${CLASS_BODY}")
    string(REGEX REPLACE "\n[ \t\n]*$" "" CLASS_BODY "${CLASS_BODY}")
    set(CLASS_BODY "struct ${NATIVE} : DaedalusInstance {${CLASS_BODY}\n\n\t\t")
    string(SHA256 CLASS_SCHEMA "${CLASS_BODY}")
    string(APPEND NPC_FIELDS "inline constexpr char ${NATIVE}Schema[] = \"${CLASS_SCHEMA}\";\n")
    string(REGEX MATCHALL "var[ \t]+[A-Za-z0-9_:]+[ \t]+[A-Za-z0-9_]+(\\[[A-Za-z0-9_:]+\\])?" FIELDS "${CLASS_BODY}")
    list(LENGTH FIELDS GENERATED_FIELD_COUNT)
    if(NOT GENERATED_FIELD_COUNT EQUAL FIELD_COUNT)
      message(FATAL_ERROR "NPC snapshot: ${RECORD_NAME} visitor covers ${GENERATED_FIELD_COUNT} of ${FIELD_COUNT} fields")
    endif()
    if(NATIVE STREQUAL "IItem")
      set(ITEM_FIELDS "// Generated from every ItemRecord field declaration.\ninline constexpr char ItemRecordSchema[] = \"${CLASS_SCHEMA}\";\ntemplate<class T, class F> void itemRecordFields(T& v, F f) {\n")
    endif()
    string(APPEND NPC_FIELDS "template<class F> void snapshotFields(daedalus::${NATIVE}& v, F f) {\n")
    foreach(FIELD IN LISTS FIELDS)
      string(REGEX MATCH "var[ \t]+([A-Za-z0-9_:]+)[ \t]+([A-Za-z0-9_]+)" MATCHED "${FIELD}")
      set(FIELD_TYPE "${CMAKE_MATCH_1}")
      set(FIELD_NAME "${CMAKE_MATCH_2}")
      set(IS_FUNCTION false)
      if(FIELD_TYPE STREQUAL "func")
        set(IS_FUNCTION true)
      endif()
      string(REGEX MATCH "register_member(<${NATIVE}>)?\\(\"([^\"]+)\", &${NATIVE}::${FIELD_NAME}\\)" BINDING "${NPC_BINDINGS}")
      set(SYMBOL "${CMAKE_MATCH_2}")
      if(SYMBOL STREQUAL "")
        message(FATAL_ERROR "NPC snapshot: ${RECORD_NAME}.${FIELD_NAME} has no Daedalus member binding")
      endif()
      string(APPEND NPC_FIELDS "  f(\"${FIELD_NAME}\", v.${FIELD_NAME}, ${IS_FUNCTION}, \"${SYMBOL}\");\n")
      if(NATIVE STREQUAL "IItem")
        string(APPEND ITEM_FIELDS "  f(\"${FIELD_NAME}\", v.${FIELD_NAME}, ${IS_FUNCTION});\n")
      endif()
    endforeach()
    string(APPEND NPC_FIELDS "}\n")
    if(NATIVE STREQUAL "IItem")
      string(APPEND ITEM_FIELDS "}\n")
    endif()
  endforeach()
  set(${npc_output} "${NPC_FIELDS}" PARENT_SCOPE)
  set(${item_output} "${ITEM_FIELDS}" PARENT_SCOPE)
endfunction()
