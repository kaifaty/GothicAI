cmake_minimum_required(VERSION 3.20)

if(NOT CMAKE_SCRIPT_MODE_FILE)
  # Use the actual translation units, not the headers globbed into IDE project views.
  set(guard_sources)
  set(guard_includes)
  foreach(target OpenGothic gothic-base-runtime gothic-video-runtime AiBridge StoryGraph Gothic2Notr gothic-body-runner)
    if(NOT TARGET ${target})
      continue()
    endif()
    get_target_property(source_dir ${target} SOURCE_DIR)
    get_target_property(sources ${target} SOURCES)
    foreach(source IN LISTS sources)
      if(source MATCHES "\\.(c|cc|cpp|cxx|m|mm)$")
        get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${source_dir}")
        if(source MATCHES "^${CMAKE_CURRENT_SOURCE_DIR}/(common|ai_bridge|game)/")
          list(APPEND guard_sources "${source}")
        endif()
      endif()
    endforeach()
    get_target_property(includes ${target} INCLUDE_DIRECTORIES)
    foreach(dir IN LISTS includes)
      if(dir MATCHES "^${CMAKE_CURRENT_SOURCE_DIR}/(common|ai_bridge|game)(/|$)")
        list(APPEND guard_includes "${dir}")
      endif()
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES guard_sources)
  list(REMOVE_DUPLICATES guard_includes)
  set(guard_inputs "${CMAKE_CURRENT_BINARY_DIR}/zenkit-guard-inputs.cmake")
  file(GENERATE OUTPUT "${guard_inputs}" CONTENT
    "set(ZENKIT_GUARD_ROOT [==[${CMAKE_CURRENT_SOURCE_DIR}]==])\nset(ZENKIT_GUARD_SOURCES [==[${guard_sources}]==])\nset(ZENKIT_GUARD_INCLUDES [==[${guard_includes}]==])\n")
  set(guard_stamp "${CMAKE_CURRENT_BINARY_DIR}/zenkit-guard.stamp")
  add_custom_command(OUTPUT "${guard_stamp}"
    COMMAND "${CMAKE_COMMAND}" "-DGUARD_INPUTS=${guard_inputs}" "-DGUARD_STAMP=${guard_stamp}"
      -P "${CMAKE_CURRENT_LIST_FILE}"
    DEPENDS ${guard_sources} "${guard_inputs}" "${CMAKE_CURRENT_LIST_FILE}"
      "${CMAKE_CURRENT_LIST_DIR}/ZenKitAllowlist.cmake"
    DEPFILE "${guard_stamp}.d"
    COMMENT "Checking game ZenKit includes"
    VERBATIM)
  add_custom_target(gothic-zenkit-guard DEPENDS "${guard_stamp}")
  foreach(target Gothic2Notr gothic-body-runner)
    if(TARGET ${target})
      add_dependencies(${target} gothic-zenkit-guard)
    endif()
  endforeach()
  return()
endif()

include("${GUARD_INPUTS}")
set(allowlist "${CMAKE_CURRENT_LIST_DIR}/ZenKitAllowlist.cmake")
include("${allowlist}")
set(pending ${ZENKIT_GUARD_SOURCES})
set(checked)
set(violations)
while(pending)
  list(POP_FRONT pending source)
  if(source IN_LIST checked)
    continue()
  endif()
  list(APPEND checked "${source}")
  file(RELATIVE_PATH relative "${ZENKIT_GUARD_ROOT}" "${source}")
  get_filename_component(source_dir "${source}" DIRECTORY)
  file(STRINGS "${source}" includes REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"]([^>\"]+)[>\"]")
  foreach(line IN LISTS includes)
    string(REGEX MATCH "include[ \t]*([<\"])([^>\"]+)[>\"]" match "${line}")
    set(delimiter "${CMAKE_MATCH_1}")
    set(header "${CMAKE_MATCH_2}")
    if(header MATCHES "^zenkit/")
      if(header IN_LIST ZENKIT_ALLOWED_HEADERS)
        continue()
      endif()
      if(header STREQUAL ZENKIT_LOG_HEADER AND relative IN_LIST ZENKIT_LOG_FILES)
        continue()
      endif()
      file(READ "${source}" content)
      string(FIND "${content}" "${line}" offset)
      string(SUBSTRING "${content}" 0 ${offset} prefix)
      string(REGEX MATCHALL "\n" newlines "${prefix}")
      list(LENGTH newlines line_number)
      math(EXPR line_number "${line_number}+1")
      string(APPEND violations "\n${relative}:${line_number}: forbidden ZenKit header <${header}>")
      continue()
    endif()
    set(search_dirs ${ZENKIT_GUARD_INCLUDES})
    if(delimiter STREQUAL "\"")
      list(PREPEND search_dirs "${source_dir}")
    endif()
    foreach(dir IN LISTS search_dirs)
      get_filename_component(candidate "${dir}/${header}" ABSOLUTE)
      if(EXISTS "${candidate}")
        if(candidate MATCHES "^${ZENKIT_GUARD_ROOT}/(common|ai_bridge|game)/")
          list(APPEND pending "${candidate}")
        endif()
        break()
      endif()
    endforeach()
  endforeach()
endwhile()
if(violations)
  message(FATAL_ERROR "ZenKit game include guard:${violations}\nAllowed headers: ${allowlist}")
endif()

# A newly included header enters the depfile on the next source/header edit.
# Escape paths for Make/Ninja depfiles, including worktrees whose paths contain spaces.
set(dependencies "${GUARD_STAMP}" ${checked})
set(escaped)
foreach(path IN LISTS dependencies)
  string(REPLACE "$" "$$" path "${path}")
  string(REPLACE "#" "\\#" path "${path}")
  string(REPLACE " " "\\ " path "${path}")
  list(APPEND escaped "${path}")
endforeach()
list(POP_FRONT escaped output)
list(JOIN escaped " " depfiles)
file(WRITE "${GUARD_STAMP}.d" "${output}: ${depfiles}\n")
file(TOUCH "${GUARD_STAMP}")
list(LENGTH ZENKIT_GUARD_SOURCES source_count)
list(LENGTH checked file_count)
message(STATUS "ZenKit game include guard: ${source_count} translation units, ${file_count} files checked")
