cmake_minimum_required(VERSION 3.20)

# Engine layer guard (reports/engine/2026-11-10-engine-layers/README.md, step 5): no platform file
# of the game targets may reach the script VM (common/daedalus/) through includes. This is
# `vm_transitive` of `census` in scripts/engine_layers.py: the layer of a file comes from its
# LAYER_RULES, read line by line, and includes resolve the same way, so both give one answer.
#
# Configure: collect the game targets' sources, write the inputs file and add gothic-layer-guard.
# Build (`cmake -P`): walk the includes, fail on a violation, write the stamp and its depfile.
# Included in script mode without GUARD_INPUTS it only defines the functions (scripts/tests).

# LAYER_RULES of `rules_file`: one ("glob", "layer") tuple per line, comments and blank lines
# between them. Globs may use letters, digits, `_`, `-`, `.`, `/` and `*`; `*` also matches `/`,
# as in fnmatch. Fills <patterns>, <layers> and <regexes> (anchored CMake regexes of the globs).
function(engine_layer_guard_read_rules rules_file patterns_var layers_var regexes_var)
  set(where "Engine layer guard: ${rules_file}")
  if(NOT EXISTS "${rules_file}")
    message(FATAL_ERROR "${where}: no such file")
  endif()
  file(READ "${rules_file}" content)
  string(REPLACE "\r" "" content "\n${content}")
  string(REGEX MATCH "\nLAYER_RULES[^\n]*=[ \t]*\\[[ \t]*\n" head "${content}")
  if(NOT head)
    message(FATAL_ERROR "${where}: no line `LAYER_RULES ... = [` that opens the rule list")
  endif()
  string(FIND "${content}" "${head}" start)
  string(LENGTH "${head}" length)
  math(EXPR start "${start} + ${length} - 1")
  string(SUBSTRING "${content}" ${start} -1 rest)
  string(FIND "${rest}" "\n]" end)
  if(end EQUAL -1)
    message(FATAL_ERROR "${where}: LAYER_RULES has no `]` at the start of a line")
  endif()
  string(SUBSTRING "${rest}" 1 ${end} block)
  set(patterns)
  set(layers)
  set(regexes)
  while(NOT block STREQUAL "")
    string(FIND "${block}" "\n" newline)
    string(SUBSTRING "${block}" 0 ${newline} line)
    math(EXPR newline "${newline} + 1")
    string(SUBSTRING "${block}" ${newline} -1 block)
    if(line MATCHES "^[ \t]*(#.*)?$")
      continue()
    endif()
    if(NOT line MATCHES "^[ \t]*\\(\"([^\"]*)\",[ \t]*\"([a-z_]+)\"\\),?[ \t]*(#.*)?$")
      message(FATAL_ERROR "${where}: LAYER_RULES line is not (\"glob\", \"layer\"), on one line: ${line}")
    endif()
    set(pattern "${CMAKE_MATCH_1}")
    set(layer "${CMAKE_MATCH_2}")
    if(NOT pattern MATCHES "^[A-Za-z0-9_./*-]+$")
      message(FATAL_ERROR "${where}: unsupported glob \"${pattern}\" in LAYER_RULES; "
        "the guard supports letters, digits, `_`, `-`, `.`, `/` and `*` (not `?` or `[...]`)")
    endif()
    string(REPLACE "." "\\." regex "${pattern}")
    string(REPLACE "*" ".*" regex "${regex}")
    list(APPEND patterns "${pattern}")
    list(APPEND layers "${layer}")
    list(APPEND regexes "^${regex}$")
  endwhile()
  if(NOT patterns)
    message(FATAL_ERROR "${where}: LAYER_RULES has no rules")
  endif()
  set(${patterns_var} "${patterns}" PARENT_SCOPE)
  set(${layers_var} "${layers}" PARENT_SCOPE)
  set(${regexes_var} "${regexes}" PARENT_SCOPE)
endfunction()

# layer_of() of engine_layers.py: the first rule that matches the path or the path without extension.
function(engine_layer_guard_layer_of path regexes layers result)
  string(REGEX REPLACE "\\.(h|cpp|c|mm)$" "" stem "${path}")
  set(index 0)
  foreach(regex IN LISTS regexes)
    if(path MATCHES "${regex}" OR stem MATCHES "${regex}")
      list(GET layers ${index} layer)
      set(${result} "${layer}" PARENT_SCOPE)
      return()
    endif()
    math(EXPR index "${index} + 1")
  endforeach()
  message(FATAL_ERROR "Engine layer guard: no layer rule for ${path}")
endfunction()

if(NOT CMAKE_SCRIPT_MODE_FILE)
  set(guard_rules "${CMAKE_CURRENT_SOURCE_DIR}/../scripts/engine_layers.py")
  cmake_path(NORMAL_PATH guard_rules)
  if(NOT EXISTS "${guard_rules}")
    # Partial copies of OpenGothic/ (remote bench and training builds) carry no scripts/.
    message(WARNING "Engine layer guard skipped: no layer rules at ${guard_rules}")
    return()
  endif()
  set(guard_sources)
  foreach(target OpenGothic gothic-base-runtime gothic-video-runtime gothic-daedalus AiBridge StoryGraph Gothic2Notr gothic-body-runner)
    if(NOT TARGET ${target})
      continue()
    endif()
    get_target_property(source_dir ${target} SOURCE_DIR)
    get_target_property(sources ${target} SOURCES)
    foreach(source IN LISTS sources)
      if(source MATCHES "\\.(h|cpp|c|mm)$")
        get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${source_dir}")
        file(RELATIVE_PATH relative "${CMAKE_CURRENT_SOURCE_DIR}" "${source}")
        if(relative MATCHES "^(common|game|ai_bridge)/")
          list(APPEND guard_sources "${source}")
        endif()
      endif()
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES guard_sources)
  if(NOT guard_sources)
    message(FATAL_ERROR "Engine layer guard: no game sources found under ${CMAKE_CURRENT_SOURCE_DIR}")
  endif()
  set(guard_inputs "${CMAKE_CURRENT_BINARY_DIR}/engine-layer-guard-inputs.cmake")
  file(GENERATE OUTPUT "${guard_inputs}" CONTENT
    "set(ENGINE_LAYER_GUARD_ROOT [==[${CMAKE_CURRENT_SOURCE_DIR}]==])\nset(ENGINE_LAYER_GUARD_RULES [==[${guard_rules}]==])\nset(ENGINE_LAYER_GUARD_SOURCES [==[${guard_sources}]==])\n")
  set(guard_stamp "${CMAKE_CURRENT_BINARY_DIR}/engine-layer-guard.stamp")
  add_custom_command(OUTPUT "${guard_stamp}"
    COMMAND "${CMAKE_COMMAND}" "-DGUARD_INPUTS=${guard_inputs}" "-DGUARD_STAMP=${guard_stamp}"
      -P "${CMAKE_CURRENT_LIST_FILE}"
    DEPENDS ${guard_sources} "${guard_inputs}" "${guard_rules}" "${CMAKE_CURRENT_LIST_FILE}"
      "${CMAKE_CURRENT_LIST_DIR}/GuardDepfile.cmake"
    DEPFILE "${guard_stamp}.d"
    COMMENT "Checking engine layers: platform files must not reach the script VM"
    VERBATIM)
  add_custom_target(gothic-layer-guard DEPENDS "${guard_stamp}")
  foreach(target Gothic2Notr gothic-body-runner)
    if(TARGET ${target})
      add_dependencies(${target} gothic-layer-guard)
    endif()
  endforeach()
  return()
endif()

if(NOT DEFINED GUARD_INPUTS)
  return()
endif()
include("${GUARD_INPUTS}")
set(root "${ENGINE_LAYER_GUARD_ROOT}")
cmake_path(NORMAL_PATH root)
string(REGEX REPLACE "(.)/$" "\\1" root "${root}")
engine_layer_guard_read_rules("${ENGINE_LAYER_GUARD_RULES}" rule_patterns rule_layers rule_regexes)

# A file is known to the census when it lies under common/, game/ or ai_bridge/ with a source
# extension. Relative paths (from OpenGothic/) name the files from here on.
set(pending)
foreach(source IN LISTS ENGINE_LAYER_GUARD_SOURCES)
  if(source STREQUAL "")
    continue()
  endif()
  file(RELATIVE_PATH relative "${root}" "${source}")
  if(relative MATCHES "^(common|game|ai_bridge)/.*\\.(h|cpp|c|mm)$" AND EXISTS "${source}")
    list(APPEND pending "${relative}")
  endif()
endforeach()
if(NOT pending)
  message(FATAL_ERROR "Engine layer guard: no game sources in ${GUARD_INPUTS}")
endif()

# Walk the includes forward from the sources. The census's INCLUDE_RE: `#include` at the start of
# a line, also inside block comments; angle includes only for our own game/ world/ graphics/
# daedalus/ prefixes. Every include tries the file's folder, then common/, OpenGothic/, ai_bridge/.
set(checked)
set(vm_files)
set(platform_files)
while(pending)
  list(POP_FRONT pending file)
  if(DEFINED "seen_${file}")
    continue()
  endif()
  set("seen_${file}" 1)
  list(APPEND checked "${file}")
  engine_layer_guard_layer_of("${file}" "${rule_regexes}" "${rule_layers}" layer)
  if(layer STREQUAL "platform")
    list(APPEND platform_files "${file}")
  endif()
  if(file MATCHES "^common/daedalus/")
    list(APPEND vm_files "${file}")
  endif()
  file(READ "${root}/${file}" content)
  string(REGEX MATCHALL "\n[ \t]*#[ \t]*include[ \t]*[<\"][^>\"\n]+[>\"]" includes "\n${content}")
  get_filename_component(directory "${file}" DIRECTORY)
  foreach(include IN LISTS includes)
    string(REGEX MATCH "include[ \t]*([<\"])([^>\"\n]+)" match "${include}")
    set(name "${CMAKE_MATCH_2}")
    if(CMAKE_MATCH_1 STREQUAL "<" AND NOT name MATCHES "^(game|world|graphics|daedalus)/")
      continue()
    endif()
    set(target "")
    foreach(prefix "${directory}/" "common/" "" "ai_bridge/")
      cmake_path(SET candidate NORMALIZE "${prefix}${name}")
      if(NOT DEFINED "known_${candidate}")
        set(known 0)
        if(candidate MATCHES "^(common|game|ai_bridge)/.*\\.(h|cpp|c|mm)$"
            AND EXISTS "${root}/${candidate}" AND NOT IS_DIRECTORY "${root}/${candidate}")
          set(known 1)
        endif()
        set("known_${candidate}" ${known})
      endif()
      if(known_${candidate})
        set(target "${candidate}")
        break()
      endif()
    endforeach()
    if(target STREQUAL "" OR target STREQUAL file OR DEFINED "line_${file}>${target}")
      continue()
    endif()
    set("line_${file}>${target}" "${include}")
    list(APPEND "included_by_${target}" "${file}")
    list(APPEND pending "${target}")
  endforeach()
endwhile()

# Walk the include graph backwards from the VM, breadth first: next_<file> is the first step of a
# shortest include chain from <file> to the VM.
set(queue ${vm_files})
foreach(file IN LISTS vm_files)
  set("next_${file}" "")
endforeach()
while(queue)
  list(POP_FRONT queue file)
  foreach(includer IN LISTS "included_by_${file}")
    if(NOT DEFINED "next_${includer}")
      set("next_${includer}" "${file}")
      list(APPEND queue "${includer}")
    endif()
  endforeach()
endwhile()

set(violations)
set(violation_count 0)
list(SORT platform_files)
foreach(file IN LISTS platform_files)
  if(NOT DEFINED "next_${file}")
    continue()
  endif()
  math(EXPR violation_count "${violation_count} + 1")
  set(chain)
  set(step "${file}")
  while(NOT "${next_${step}}" STREQUAL "")
    set(target "${next_${step}}")
    file(READ "${root}/${step}" content)
    set(edge "line_${step}>${target}")
    string(FIND "\n${content}" "${${edge}}" offset)
    string(SUBSTRING "\n${content}" 0 ${offset} prefix)
    string(REGEX MATCHALL "\n" newlines "${prefix}")
    list(LENGTH newlines line_number)
    math(EXPR line_number "${line_number} + 1")
    list(APPEND chain "${step}:${line_number}")
    set(step "${target}")
  endwhile()
  list(APPEND chain "${step}")
  list(JOIN chain " -> " chain)
  string(APPEND violations "\n  ${chain}")
endforeach()
list(LENGTH platform_files platform_count)
list(LENGTH checked file_count)
if(violations)
  message(FATAL_ERROR "Engine layer guard: ${violation_count} of ${platform_count} platform files "
    "reach the script VM (common/daedalus/) through includes; shortest chains, file:line of each include:"
    "${violations}\n"
    "Platform files must not include the VM or game/gamescript.h, even through rpg or gothic headers. "
    "Layer rules: scripts/engine_layers.py (LAYER_RULES); plan: reports/engine/2026-11-10-engine-layers/README.md")
endif()

set(dependencies "${ENGINE_LAYER_GUARD_RULES}")
foreach(file IN LISTS checked)
  list(APPEND dependencies "${root}/${file}")
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/GuardDepfile.cmake")
guard_write_depfile("${GUARD_STAMP}" ${dependencies})
message(STATUS "Engine layer guard: ${platform_count} platform files of ${file_count} files checked, none reach the script VM")
