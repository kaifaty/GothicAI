float hiZFetch(in sampler2D hiZ, in ivec2 ibbox[2]) {
  if(ibbox[0]==ibbox[1])
    return texelFetch(hiZ, ibbox[0], 0).x;

  const uint sz  = max(ibbox[1].x-ibbox[0].x, ibbox[1].y-ibbox[0].y);
  const int  mip = findMSB(sz - 1) + 1; // log2 of next pot

  ibbox[0].x = (ibbox[0].x >> mip);
  ibbox[0].y = (ibbox[0].y >> mip);

  ivec2 hiZsize = textureSize(hiZ,mip);
  float z =  texelFetchOffset(hiZ, ibbox[0], mip, ivec2(0,0)).x;
  if(ibbox[0].x+1<hiZsize.x)
    z = max(z, texelFetchOffset(hiZ, ibbox[0], mip, ivec2(1,0)).x);
  if(ibbox[0].y+1<hiZsize.y)
    z = max(z, texelFetchOffset(hiZ, ibbox[0], mip, ivec2(0,1)).x);
  if(ibbox[0].x+1<hiZsize.x && ibbox[0].y+1<hiZsize.y)
    z = max(z, texelFetchOffset(hiZ, ibbox[0], mip, ivec2(1,1)).x);

  return z;
  }

#if defined(MAIN_VIEW)
bool projectSphere(const vec4 sphere, out vec4 aabb, out float depthMin) {
  const vec3  c     = (scene.view * vec4(sphere.xyz, 1)).xyz;
  const float R     = sphere.w;
  const float znear = push.znear;

  if(c.z - R < znear) {
    depthMin = 0;
    aabb     = vec4(0,0,1,1);
    return true;
    }

  float z = c.z - R;
  depthMin  = scene.project[3][2]/z + scene.project[2][2];
  float P00 = scene.project[0][0];
  float P11 = scene.project[1][1];

  vec3  cr   = c * R;
  float czr2 = c.z * c.z - R * R;

  float vx   = sqrt(c.x * c.x + czr2);
  float minx = (vx * c.x - cr.z) / (vx * c.z + cr.x);
  float maxx = (vx * c.x + cr.z) / (vx * c.z - cr.x);

  float vy   = sqrt(c.y * c.y + czr2);
  float miny = (vy * c.y - cr.z) / (vy * c.z + cr.y);
  float maxy = (vy * c.y + cr.z) / (vy * c.z - cr.y);

  aabb = vec4(minx * P00, miny * P11, maxx * P00, maxy * P11);
  aabb = aabb*0.5 + vec4(0.5);
  return true;
  }

bool projectInstance(const Cluster cluster, inout bool preciseBox, out vec4 aabb, out float depthMin) {
  const uint  bId        = cluster.bucketId_commandId >> 16;
  const uint  instanceId = cluster.instanceId;

  vec3        b[2]       = {bucket[bId].bbox[0].xyz, bucket[bId].bbox[1].xyz};
  Instance    obj        = pullInstance(instanceId);
  const float znear      = push.znear;

  // The shared authored box describes the flat rest mesh. A nearby soft body
  // can fold outside it, so use its conservative instance sphere for frustum
  // culling and keep it out of the rest-box HiZ/small-object rejection.
  if(obj.deformCount>0) {
    aabb = vec4(0,0,1,1);
    depthMin = 0;
    return true;
    }

#if !defined(LARGE)
  // These vertices can leave the authored rest box. Keep their established decision until a
  // bound for the animated geometry is available.
  if(preciseBox && ((bucket[bId].flags & (BK_SKIN | BK_MORPH | BK_STRAND))!=0u || obj.fatness!=0))
    preciseBox = false;
  if(preciseBox) {
    vec3 lo, hi;
    if(treeHiZBox(cluster, bucket[bId], obj.mat, scene.camPos, scene.foliageFade.x, lo, hi)) {
      b[0] = lo;
      b[1] = hi;
      }
    }
#endif

  aabb     = vec4(1, 1, -1, -1);
  depthMin = 1;
  for(uint i=0; i<8; ++i) {
    const vec3 pos = vec3(b[bitfieldExtract(i,0,1)].x,
                          b[bitfieldExtract(i,1,1)].y,
                          b[bitfieldExtract(i,2,1)].z);
    vec4 trPos = vec4(pos,1.0);
    trPos = vec4(obj.mat*trPos, 1.0);
    trPos = scene.viewProject*trPos;
    if(trPos.w<znear) {
      depthMin = 0;
      aabb     = vec4(0,0,1,1);
      return true;
      }

    vec3 bp = trPos.xyz/trPos.w;

    aabb.xy  = min(aabb.xy,  bp.xy);
    aabb.zw  = max(aabb.zw,  bp.xy);
    depthMin = min(depthMin, bp.z);
    }

  aabb = aabb*0.5 + vec4(0.5);
  return true;
  }

bool hiZTest(vec4 sbbox, float depthMin) {
  if(depthMin<=0)
    return true;

  ivec2 hiZsize = textureSize(hiZ,0);
  ivec2 ibbox[2];
  ibbox[0] = ivec2(sbbox.xy * scene.screenRes) / scene.hiZTileSize;
  ibbox[1] = ivec2(sbbox.zw * scene.screenRes) / scene.hiZTileSize;
  ibbox[0] = clamp(ibbox[0], ivec2(0), hiZsize - ivec2(1));
  ibbox[1] = clamp(ibbox[1], ivec2(0), hiZsize - ivec2(1));

  float bz      = packHiZ(depthMin);
  float z       = hiZFetch(hiZ, ibbox);
  if(bz > z)
    return false;
  return true;
  }

bool hiZTestPrecise(vec4 sbbox, float depthMin) {
  if(depthMin<=0)
    return true;

  // Take whole pixel cells, including the cell starting at an exact upper edge.
  // Raster samples next to a tile boundary are half a pixel away from it.
  const vec2 screenLast = vec2(scene.screenRes - ivec2(1));
  ivec2 lo = ivec2(clamp(sbbox.xy * scene.screenRes, vec2(0), screenLast)) / scene.hiZTileSize;
  ivec2 hi = ivec2(clamp(sbbox.zw * scene.screenRes, vec2(0), screenLast)) / scene.hiZTileSize;
  const ivec2 span = hi - lo;
  // Any finer level has tiles at most half as wide as the span on one axis.
  int mip = findMSB(max(1, max(span.x, span.y)));
  lo >>= mip;
  hi >>= mip;
  if(any(greaterThan(hi - lo, ivec2(1)))) {
    ++mip;
    lo >>= 1;
    hi >>= 1;
    }

  float z = texelFetch(hiZ, lo, mip).x;
  if(lo.x != hi.x)
    z = max(z, texelFetch(hiZ, ivec2(hi.x, lo.y), mip).x);
  if(lo.y != hi.y)
    z = max(z, texelFetch(hiZ, ivec2(lo.x, hi.y), mip).x);
  if(lo.x != hi.x && lo.y != hi.y)
    z = max(z, texelFetch(hiZ, hi, mip).x);
  return !(packHiZ(depthMin) > z);
  }


bool projectCluster(const Cluster cluster, inout bool preciseBox, out vec4 aabb, out float depthMin) {
  if(cluster.instanceId==0xFFFFFFFF) {
    bool projected = projectSphere(cluster.sphere, aabb, depthMin);
#if !defined(LARGE)
    // The tangent formula uses the projection diagonal. Restore the offset of the raster projection.
    if(preciseBox && depthMin>0)
      aabb += scene.project[2].xyxy*0.5;
#endif
    return projected;
    }
  return projectInstance(cluster, preciseBox, aabb, depthMin);
  }
#endif

bool frustrumTest(const vec4 sphere) {
  if(sphere.w<0.f)
    return false;

  for(int i=0; i<6; ++i) {
    if(dot(vec4(sphere.xyz,1.0), scene.frustrum[i]) <= -sphere.w) {
      return false;
      }
    }

  return true;
  }

void runCluster(const uint clusterId) {
  Cluster cluster = clusters[clusterId];
  if(cluster.sphere.w<=0.f || cluster.meshletCount<=0)
    return; // disabled or deleted

  if(push.ownMeshMask != 0u) {
    const uint bucketId = cluster.bucketId_commandId >> 16;
    if(cluster.instanceId == 0xFFFFFFFF || (bucket[bucketId].flags & BK_OWN_MESH) == 0u)
      return;
  }

  if(!frustrumTest(cluster.sphere))
    return;

  uint level;
  if(!clusterLodVisible(clusterId, cluster.instanceId, level))
    return;

#if defined(MAIN_VIEW)
#if defined(LARGE)
  bool preciseBox = false;
#else
  bool preciseBox = (scene.viewFlags & VF_HIZ_PRECISE)!=0u;
#endif
#if !defined(HIZ_PROBE)
  vec4  aabb     = vec4(0);
  float depthMin = 1;
  if(!projectCluster(cluster, preciseBox, aabb, depthMin))
    return;
#endif
#endif

#if defined(LARGE)
  {
    vec2 sz = (aabb.zw - aabb.xy)*textureSize(hiZ, 0);
    // if(sz.x*sz.y<4)
    //   return;
    if(sz.x*sz.y<16 && cluster.instanceId!=0xFFFFFFFF)
      return;
  }
#endif

#if defined(HIZ_PROBE)
  vec4 wideRect, tightRect;
  float wideDepth, tightDepth;
  bool legacyBox = false, supported = true;
  projectCluster(cluster, legacyBox, wideRect, wideDepth);
  projectCluster(cluster, supported, tightRect, tightDepth);
  const bool oldPass = hiZTest(wideRect, wideDepth);
  const bool newPass = supported ? hiZTestPrecise(tightRect, tightDepth) : oldPass;
  const bool widePass = supported && cluster.instanceId!=0xffffffffu ? hiZTestPrecise(wideRect, wideDepth) : newPass;
  const bool drawPrecise = preciseBox && (scene.viewFlags & VF_HIZ_VERIFY)==0u;
  const bool drawn = drawPrecise ? newPass : oldPass;
  hizDecisions[clusterId] = (oldPass ? 1u : 0u) | (newPass ? 2u : 0u) | (widePass ? 4u : 0u) | 8u | (drawn ? 16u : 0u);
  if(!drawn)
    return;
#elif defined(HIZ)
#if defined(LARGE)
  if(!hiZTest(aabb, depthMin))
#else
  if(!(preciseBox ? hiZTestPrecise(aabb, depthMin) : hiZTest(aabb, depthMin)))
#endif
    return;
#endif

#if !defined(MAIN_VIEW)
  if((scene.viewFlags & VF_SHADOW)!=0u)
    cluster = shadowCluster(cluster);
#endif

  const uint commandId  = cluster.bucketId_commandId & 0xFFFF;
  const uint bucketId   = cluster.bucketId_commandId >> 16;
  const uint instanceId = cluster.instanceId;
  const uint meshletId  = cluster.firstMeshlet;

  int meshletCount = cluster.meshletCount;
  // a tree's alpha-tested leaves: no occluder (graphics/hizoccluders.h); the G-buffer draws them as before
  const uint noCanopy = VF_HIZ | VF_HIZ_NO_CANOPY;
  if(instanceId!=0xFFFFFFFF && (scene.viewFlags & noCanopy)==noCanopy && (bucket[bucketId].flags & BK_CANOPY)!=0u)
    return;
  if(instanceId!=0xFFFFFFFF && (bucket[bucketId].flags & BK_STRAND)!=0u) {
    // strands: never an occluder; a shadow view takes the first part of the list
    if((scene.viewFlags & VF_HIZ)!=0u)
      return;
    if((scene.viewFlags & VF_SHADOW)!=0u)
      meshletCount = strandShadowMeshlets(meshletCount, pullInstance(instanceId).fatness);
    }

  uint writeOffset = cmd[commandId].writeOffset;
  writeOffset      += atomicAdd(cmd[commandId].instanceCount, meshletCount);
#if defined(HIZ_PROBE)
  const uint debugLevel = clusterId;
#elif defined(MAIN_VIEW) && !defined(LARGE)
  const uint debugLevel = push.lodDebug != 0u ? level : 0u;
#else
  const uint debugLevel = 0u;
#endif
  for(int i=0; i<meshletCount; ++i)
    payload[writeOffset+i] = uvec4(instanceId, meshletId+i, bucketId, debugLevel);
  }

void main() {
#if defined(ORDERED)
  // bench `deterministic on`: one invocation appends the clusters in their order
  if(gl_GlobalInvocationID.x!=0)
    return;
  for(uint i=0; i<push.meshletCount; ++i)
    runCluster(order[i]);
#else
  const uint clusterId = gl_GlobalInvocationID.x;
  if(clusterId<push.meshletCount)
    runCluster(clusterId);
#endif
  }
