#version 450
#extension GL_GOOGLE_include_directive : enable

#include "scene.glsl"

layout(local_size_x = 64) in;
layout(binding = 0, std140) uniform Scene        { SceneDesc scene;      };
layout(binding = 1, std430) buffer MainPayload  { uvec4 mainPayload[];  };
layout(binding = 2, std430) readonly buffer Mem  { uint instanceMem[];   };
layout(binding = 3, std430) readonly buffer Data { uint data[];          };
layout(binding = 4, std430) buffer MainDraws    { IndirectCmd mainCmd[]; };
layout(binding = 5, std430) readonly buffer Cls { Cluster clusters[];   };
layout(binding = 6, std430) buffer CutState     { uint state[];          };
layout(binding = 7, std430) readonly buffer Ref { uint reference[];     };
layout(binding = 8, std430) buffer BoughDraws   { IndirectCmd cmd[];     };
layout(binding = 9, std430) buffer BoughPayload { uvec4 payload[];       };
layout(binding = 10, std430) readonly buffer HiZHistory { uint historyStatus[]; };

layout(push_constant, std430) uniform Push {
  uint token;
  uint flags; // bit 0: CPU reference, bit 1: counters, bit 2: HiZ probe, bit 3: late history HiZ
  float nearZ;
  uint stage; // 0: cut of each crown, 1: reset of the counters, 2: whole meshlets of the mesh path
  } push;

#include "materials/tree_bough_cut.glsl"

#ifdef TREE_COVERAGE
#include "tree_coverage_lod.glsl"
layout(binding = 11, std430) buffer Coverage { uint coverageHistory[]; };
layout(binding = 12, std430) buffer CoverageDispatch { uint groups[]; };
shared uint age;

float crownBoxPixels(mat4x3 object, vec3 low, vec3 high) {
  vec2 lo = vec2(1.0), hi = vec2(-1.0);
  for(uint i=0u; i<8u; ++i) {
    const vec3 corner = mix(low,high,notEqual(uvec3(i) & uvec3(1,2,4),uvec3(0)));
    const vec4 clip = scene.viewProject*vec4(object*vec4(corner,1),1);
    if(clip.w<=push.nearZ)
      return float(scene.screenRes.x)*float(scene.screenRes.y);
    lo = min(lo,clip.xy/clip.w);
    hi = max(hi,clip.xy/clip.w);
    }
  const vec2 size = max(vec2(0),clamp(hi,-1.0,1.0)-clamp(lo,-1.0,1.0))*0.5*vec2(scene.screenRes);
  return size.x*size.y;
  }
#endif

// The state prefix matches TreeBoughRender::readStats. Height is a maximum; the other counters are sums.
const uint BoughStatsSumCount = 7u;
const uint BoughStatsCount = BoughStatsSumCount + 1u;
shared uint hasCompact;
shared uint mainOffset;
shared uint stats[BoughStatsSumCount];
uint instanceId, nodeBase, rangeBase;
uint countByLane[BoughStatsSumCount];

vec3 readVec(uint offset) {
  return uintBitsToFloat(uvec3(data[offset], data[offset+1u], data[offset+2u]));
  }

BoughNode boughGetNode(uint i) {
  uint at = nodeBase+i*16u;
  return BoughNode(vec4(0), readVec(at+4u), uintBitsToFloat(data[at+7u]),
                   readVec(at+8u), uintBitsToFloat(data[at+11u]),
                   uintBitsToFloat(data[at+12u]), uintBitsToFloat(data[at+13u]),
                   data[at+14u], data[at+15u]);
  }

void boughEmit(uint i, uint transition, float weight) {
  uint at = rangeBase+i*4u;
  uint firstIndex = data[at], indexCount = data[at+1u];
  uint key = data[at+2u], command = key & 0xffffu, bucket = key >> 16u;
  uint offset = cmd[command].writeOffset + atomicAdd(cmd[command].instanceCount, 1u);
  uint band = uint(round(weight*float(BoughWeightMask)));
  payload[offset] = uvec4(instanceId, firstIndex, bucket | (transition << 16u), (indexCount << 24u) | band);
  if((push.flags & 2u)!=0u) {
    bool source = boughGetNode(i).subtreeEnd==i+1u;
    uint cards = data[at+3u];
    uint triangles = indexCount/3u;
    ++countByLane[0];
    countByLane[source ? 1 : 2] += cards;
    countByLane[3] += triangles;
    if(transition!=0u) {
      // Each active owner emits once. Each resolved child-side node pairs with that owner.
      bool childSide = (transition & BoughChildSide)!=0u;
      ++countByLane[childSide ? 5 : 4];
      countByLane[6] += triangles;
      }
    }
  }

vec3 transformColumn(uint offset) {
  return uintBitsToFloat(uvec3(instanceMem[offset], instanceMem[offset+1u], instanceMem[offset+2u]));
  }

void main() {
  const uint lane = gl_LocalInvocationIndex;
  if(push.stage==1u) {
    uint i = gl_GlobalInvocationID.x;
#ifdef TREE_COVERAGE
    if(i==0u) {
      groups[0] = 0u;
      groups[1] = (uint(scene.screenRes.y)+31u)/32u;
      }
#endif
    if(i<cmd.length())
      cmd[i].instanceCount = 0u;
    if(i<BoughStatsCount)
      state[i] = 0u;
    return;
    }
  if(push.stage==2u) {
    // A mesh workgroup draws cmd.vertexCount nodes: empty ones fill the last group.
    uint i = gl_GlobalInvocationID.x;
    if(i<cmd.length()) {
      const uint size = cmd[i].vertexCount, count = cmd[i].instanceCount;
      const uint groups = (count+size-1u)/size;
      for(uint at=count; at<groups*size; ++at)
        payload[cmd[i].writeOffset+at] = uvec4(0);
      cmd[i].instanceCount = groups;
      }
    return;
    }

  const uint entry = data[1] + gl_WorkGroupID.x*8u;
  const uint clusterId = data[entry];
  const uint asset = data[entry+4u];
  const uint stateBase = data[entry+5u];
  const uint ref = data[entry+6u];
  const uint status = state[stateBase];
  if((status & ~1u)!=push.token)
    return;
  if((push.flags & 8u)!=0u && (status & 1u)==0u && (historyStatus[clusterId] & 8u)!=0u)
    return;

  const Cluster cluster = clusters[clusterId];
  instanceId = cluster.instanceId;
  const uint transform = instanceId*16u;
  const vec3 x = transformColumn(transform), y = transformColumn(transform+3u);
  const vec3 z = transformColumn(transform+6u), origin = transformColumn(transform+9u);
  const float focal = 0.5*float(scene.screenRes.y)*abs(scene.project[1][1]);
  if(lane==0u && (push.flags & 2u)!=0u) {
    vec3 center = mat3(x, y, z)*readVec(asset+8u) + origin;
    float height = uintBitsToFloat(data[asset+11u]) * length(y) * focal / max(length(center-scene.camPos), 1.0);
    atomicMax(state[BoughStatsSumCount], uint(clamp(height*1000.0, 0.0, 4294967040.0)));
    }
  if((status & 1u)!=0u)
    return; // impostor

  const vec3 forward = vec3(scene.view[0][2], scene.view[1][2], scene.view[2][2]);
  const vec3 shear = abs(vec3(dot(x, y), dot(y, z), dot(z, x)));
  const vec3 scale = vec3(dot(x, x), dot(y, y), dot(z, z)) + shear + shear.zxy;
  const float scaleBound = sqrt(max(max(scale.x, scale.y), scale.z));
  BoughProjection projection = BoughProjection(vec3(dot(forward, x), dot(forward, y), dot(forward, z)),
                                                dot(forward, origin)+scene.view[3][2], focal*scaleBound, push.nearZ);
  const uint nodeCount = data[asset+3u];
  nodeBase = data[asset+2u];
  rangeBase = data[asset+4u];
  // Equal slices of the preorder array: one long bough no longer holds the whole workgroup.
  const uint slice = (nodeCount+gl_WorkGroupSize.x-1u)/gl_WorkGroupSize.x;
  const uint sliceFirst = min(lane*slice, nodeCount), sliceLast = min(sliceFirst+slice, nodeCount);

  const bool useReference = (push.flags & 1u)!=0u;
  if(lane==0u)
    hasCompact = useReference ? reference[ref] : 0u;
  if((push.flags & 2u)!=0u) {
    if(lane<BoughStatsSumCount)
      stats[lane] = 0u;
    for(uint i=0u; i<BoughStatsSumCount; ++i)
      countByLane[i] = 0u;
    }
  barrier();

  if(!useReference) {
    // A conservative asset-wide screen scale can prove that every band is open in the close-up.
    const vec3 farthest = mix(readVec(asset+15u), readVec(asset+12u), lessThan(projection.forwardLocal, vec3(0)));
    const float farDepth = projection.originDepth+dot(projection.forwardLocal,farthest);
    const float openScale = uintBitsToFloat(data[asset+7u]);
    if(farDepth>projection.nearZ && projection.focalScale<=farDepth*openScale) {
      if(boughMerges(sliceFirst, sliceLast, projection))
        atomicOr(hasCompact, 1u);
      }
    }
  barrier();

#ifdef TREE_COVERAGE
  if(lane==0u) {
    age = 0u;
    if(hasCompact!=0u || data[entry+7u]!=0u) {
      const uint at = gl_WorkGroupID.x*3u;
      const bool consecutive = (push.flags & 8u)!=0u && coverageHistory[at+2u]!=0u &&
                               coverageHistory[at+2u]+2u==push.token;
      const uint wins = coverageHistory[at];
      if(consecutive && wins==0u) {
        const float pixels = crownBoxPixels(mat4x3(x,y,z,origin),readVec(asset+12u),readVec(asset+15u));
        age = coverageAge(coverageHistory[at+1u],wins,pixels,true);
        }
      coverageHistory[at] = 0u;
      coverageHistory[at+1u] = age;
      coverageHistory[at+2u] = push.token;
      // Every tagged crown opens the same full-plane dispatch for its current observation.
      atomicOr(groups[0],(uint(scene.screenRes.x)+31u)/32u);
      }
    }
  barrier();
#endif

  if(hasCompact==0u) {
    // No node has been merged and no band participates. The old full canopy is more compact.
    const uint command = data[entry+1u] & 0xffffu;
#ifdef TREE_COVERAGE
    const uint level = age==CoverageLowFrames ? data[entry+7u] : 0u;
    const uint first = level!=0u ? data[level] : data[entry+2u];
    const uint count = level!=0u ? data[level+1u] : data[entry+3u];
#else
    const uint first = data[entry+2u], count = data[entry+3u];
#endif
    if(lane==0u) {
      mainOffset = mainCmd[command].writeOffset + atomicAdd(mainCmd[command].instanceCount, count);
      if((push.flags & 2u)!=0u) {
#ifdef TREE_COVERAGE
        if(level!=0u)
          atomicAdd(state[3],data[level+2u]);
        else {
#endif
        atomicAdd(state[0], data[asset+5u]);
        atomicAdd(state[1], data[asset+5u]);
        atomicAdd(state[3], data[asset+6u]);
#ifdef TREE_COVERAGE
          }
#endif
        }
      }
    barrier();
    const uint bucket = cluster.bucketId_commandId >> 16u;
#ifdef TREE_COVERAGE
    const uint probeId = clusterId+1u;
#else
    const uint probeId = (push.flags & 4u)!=0u ? clusterId : 0u;
#endif
    for(uint i=lane; i<count; i+=gl_WorkGroupSize.x)
      mainPayload[mainOffset+i] = uvec4(instanceId, first+i, bucket, probeId);
    return;
    }

  if(useReference) {
    for(uint i=lane; i<nodeCount; i+=gl_WorkGroupSize.x) {
      const uint transition = reference[ref+1u+i*2u];
      if(transition!=0xffffffffu)
        boughEmit(i, transition, uintBitsToFloat(reference[ref+2u+i*2u]));
      }
    }
  else {
#ifdef TREE_COVERAGE
    projection.focalScale *= coverageScale(age);
#endif
    boughWalkSlice(sliceFirst, sliceLast, projection);
    }

  if((push.flags & 2u)!=0u) {
    for(uint i=0u; i<BoughStatsSumCount; ++i)
      if(countByLane[i]>0u)
        atomicAdd(stats[i], countByLane[i]);
    barrier();
    if(lane<BoughStatsSumCount && stats[lane]>0u)
      atomicAdd(state[lane], stats[lane]);
    }
  }
