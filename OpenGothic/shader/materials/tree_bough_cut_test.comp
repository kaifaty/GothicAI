#version 450

#extension GL_GOOGLE_include_directive : enable

#include "tree_bough_cut.glsl"

layout(local_size_x = 1) in;
layout(binding = 0, std430) readonly buffer Nodes { BoughNode nodes[]; };
layout(binding = 1, std430) readonly buffer Views { BoughProjection views[]; };
layout(binding = 2, std430) readonly buffer Roots { uint roots[]; };
layout(binding = 3, std430) writeonly buffer Cuts { uvec4 cuts[]; };
layout(binding = 4, std430) readonly buffer JointWeights { uint joints[]; };

uint first, count, maskFailures;

BoughNode boughGetNode(uint i) {
  return nodes[i];
  }

uint coverageFailures(uint fade, uint seed) {
  uint failures = 0u;
  const uint weight = fade & BoughWeightMask;
  for(uint pixel=0u; pixel<64u; ++pixel) {
    const vec2 sampleOffset = vec2(pixel % 8u, pixel / 8u) - vec2(3.5);
    const bool parent = boughCovers(fade, seed, sampleOffset);
    const bool child = boughCovers(fade | BoughFadeChild, seed, sampleOffset);
    failures += uint(parent==child || (weight==0u && parent) || (weight==BoughWeightMask && child) ||
                     !boughCovers(0u, seed, sampleOffset));
    }
  return failures;
  }

void boughEmit(uint i, uint transition, float weight) {
  cuts[first + 1u + count++] = uvec4(i, transition, floatBitsToUint(weight), 0u);
  if(transition!=0u && (transition & BoughChildSide)==0u)
    maskFailures += coverageFailures(BoughFadeActive | uint(weight * float(BoughWeightMask)), i);
  }

void main() {
  const uint stride = uint(nodes.length()) + 1u;
  for(uint sampleId = 0; sampleId < uint(views.length()); ++sampleId) {
    first = sampleId * stride;
    count = 0u;
    maskFailures = 0u;
    if(sampleId==0u)
      maskFailures = coverageFailures(BoughFadeActive, 0u) + coverageFailures(BoughFadeActive | BoughWeightMask, 0u);
    const uint joint = boughJointFade(joints[sampleId]);
    if(joint!=0u)
      maskFailures += coverageFailures(joint, 123u);
    bool compact = false;
    for(uint root = 0; root < uint(roots.length()); ++root) {
      if(boughWalk(roots[root], views[sampleId], false))
        compact = true;
      }
    for(uint root = 0; root < uint(roots.length()); ++root)
      boughWalk(roots[root], views[sampleId], true);
    cuts[first] = uvec4(count, uint(compact), maskFailures, joint);
    }
  }
