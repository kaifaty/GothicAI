#version 450

#extension GL_GOOGLE_include_directive : enable

#include "tree_bough_cut.glsl"
#include "tree_bough_hiz.glsl"

layout(local_size_x = 1) in;
layout(binding = 0, std430) readonly buffer Nodes { BoughNode nodes[]; };
layout(binding = 1, std430) readonly buffer Views { BoughProjection views[]; };
layout(binding = 3, std430) writeonly buffer Cuts { uvec4 cuts[]; };
layout(binding = 4, std430) readonly buffer JointWeights { uint joints[]; };
layout(binding = 5) uniform sampler2D depthPyramid;

uint first, count, maskFailures;

BoughNode boughGetNode(uint i) {
  return nodes[i];
  }

uint coverageFailures(uint fade, uint seed) {
  uint failures = 0u;
  const uint weight = fade & BoughWeightMask;
  for(uint pixel=0u; pixel<64u; ++pixel) {
    const vec2 sampleOffset = vec2(pixel % 8u, pixel / 8u) - vec2(3.5);
    const bool parent = boughCovers(fade, seed, sampleOffset);
    const bool child = boughCovers(fade | BoughFadeChild, seed, sampleOffset);
    failures += uint(parent==child || (weight==0u && parent) || (weight==BoughWeightMask && child) ||
                     !boughCovers(0u, seed, sampleOffset));
    }
  return failures;
  }

void boughEmit(uint i, uint transition, float weight) {
  cuts[first + 1u + count++] = uvec4(i, transition, floatBitsToUint(weight), 0u);
  if(transition!=0u && (transition & BoughChildSide)==0u)
    maskFailures += coverageFailures(BoughFadeActive | uint(weight * float(BoughWeightMask)), i);
  }

bool hizHidden(mat4 viewProject, vec3 lo, vec3 hi) {
  vec4 rect;
  float nearest;
  return projectBounds(viewProject, mat4(0), lo, hi, 0.1, rect, nearest)==BoundsProjected &&
         coveredByDepth(depthPyramid, ivec2(64, 32), rect, nearest);
  }

void hizCases(uint firstResult) {
  const mat4 viewProject = mat4(1);
  mat4 turned = viewProject;
  turned[3].x = 1.0;
  const vec3 lo = vec3(-0.8, -0.6, 0.5), hi = vec3(-0.7, -0.4, 0.6);
  cuts[firstResult] = uvec4(
    hizHidden(viewProject, lo, hi),
    hizHidden(turned, lo, hi), // The previous candidate is visible with the current view.
    hizHidden(viewProject, lo + vec3(1.5, 0, 0), hi + vec3(1.5, 0, 0)), // Missing depth.
    hizHidden(viewProject, vec3(-0.2, -0.6, 0.5), vec3(-0.01, -0.4, 0.6))); // The pixel guard reaches the sky.

  const vec3 windLo = vec3(lo.xy, 0.32);
  cuts[firstResult+1u] = uvec4(
    hizHidden(viewProject, windLo, hi),
    hizHidden(viewProject, windLo - 0.025, hi + 0.025),
    hizHidden(viewProject, vec3(lo.xy, 0.30001), hi), // D16 depth rounding can erase this gap.
    hizHidden(viewProject, vec3(lo.xy, -0.001), hi)); // The box crosses the near clip plane.
  }

void main() {
  const uint stride = uint(nodes.length()) + 1u;
  for(uint sampleId = 0; sampleId < uint(views.length()); ++sampleId) {
    first = sampleId * stride;
    count = 0u;
    maskFailures = 0u;
    if(sampleId==0u)
      maskFailures = coverageFailures(BoughFadeActive, 0u) + coverageFailures(BoughFadeActive | BoughWeightMask, 0u);
    const uint joint = boughJointFade(joints[sampleId]);
    if(joint!=0u)
      maskFailures += coverageFailures(joint, 123u);
    // The slices of the expansion in their order, at varying sizes: they have to give the cut of one walk.
    const uint nodeCount = uint(nodes.length()), slice = 1u + sampleId % 7u;
    bool compact = false;
    for(uint at = 0u; at < nodeCount; at += slice) {
      if(boughMerges(at, min(at+slice, nodeCount), views[sampleId]))
        compact = true;
      }
    for(uint at = 0u; at < nodeCount; at += slice)
      boughWalkSlice(at, min(at+slice, nodeCount), views[sampleId]);
    cuts[first] = uvec4(count, uint(compact), maskFailures, joint);
    }
  hizCases(uint(views.length()) * stride);
  }
