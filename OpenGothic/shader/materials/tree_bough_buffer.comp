#version 450

layout(local_size_x = 64) in;
layout(binding = 0, std430) readonly buffer Source { uint source[]; };
layout(binding = 1, std430) writeonly buffer Destination { uint destination[]; };

layout(push_constant, std430) uniform Push {
  uint offset;
  uint count;
  uint sourceCount;
  } push;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if(i<push.count)
    destination[push.offset+i] = i<push.sourceCount ? source[i] : 0u;
  }
