#version 460
#extension GL_ARB_separate_shader_objects : enable

// Decimated depth for the far samples of ssao.comp: level k holds the depth of one pixel of the depth buffer, the
// top-left of its 2^(k+1) block, unfiltered, so a read gives the very value the buffer has there. Far samples read
// a small level, and the reads of neighbouring threads, scattered by their white rotations, stay in the cache.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D depthBuf;
layout(binding = 1, r32f) uniform writeonly image2D lvl0;
layout(binding = 2, r32f) uniform writeonly image2D lvl1;
layout(binding = 3, r32f) uniform writeonly image2D lvl2;
layout(binding = 4, r32f) uniform writeonly image2D lvl3;
layout(binding = 5, r32f) uniform writeonly image2D lvl4;
layout(binding = 6, r32f) uniform writeonly image2D lvl5;

void main() {
  const ivec2 t = ivec2(gl_GlobalInvocationID.xy);
  if(any(greaterThanEqual(t, imageSize(lvl0))))
    return;
  const vec4 z = vec4(texelFetch(depthBuf, min(2*t, textureSize(depthBuf,0)-1), 0).r);
  imageStore(lvl0, t, z);
  // a level of an odd size has no texel for the last row or column of the one above
  if(((t.x|t.y) & 1)!=0 || any(greaterThanEqual(t>>1, imageSize(lvl1))))
    return;
  imageStore(lvl1, t>>1, z);
  if(((t.x|t.y) & 3)!=0 || any(greaterThanEqual(t>>2, imageSize(lvl2))))
    return;
  imageStore(lvl2, t>>2, z);
  if(((t.x|t.y) & 7)!=0 || any(greaterThanEqual(t>>3, imageSize(lvl3))))
    return;
  imageStore(lvl3, t>>3, z);
  if(((t.x|t.y) & 15)!=0 || any(greaterThanEqual(t>>4, imageSize(lvl4))))
    return;
  imageStore(lvl4, t>>4, z);
  if(((t.x|t.y) & 31)!=0 || any(greaterThanEqual(t>>5, imageSize(lvl5))))
    return;
  imageStore(lvl5, t>>5, z);
  }
