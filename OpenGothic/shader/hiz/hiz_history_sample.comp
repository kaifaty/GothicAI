#version 450

#extension GL_GOOGLE_include_directive : enable

#include "common.glsl"
#include "scene.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform usampler2D winners;
layout(binding = 1, std430) buffer History { uvec2 history[]; };
layout(binding = 2, std430) readonly buffer Clusters { Cluster clusters[]; };
layout(binding = 3, std430) writeonly buffer Status { uint status[]; };
layout(binding = 4, std430) writeonly buffer Stats { uint stats[]; };

layout(push_constant, std430) uniform Push {
  uint clusterCount;
  uint phase;
  } push;

void main() {
  if(push.phase == 1u) {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy) * 4 + 2;
    if(any(greaterThanEqual(pixel, textureSize(winners, 0))))
      return;
    const uint id = texelFetch(winners, pixel, 0).r;
    if(id != 0u && id <= push.clusterCount)
      atomicAdd(history[id - 1u].x, 1u);
    return;
    }

  // Clear 64 contiguous slots in an 8x8 workgroup. The host dispatches ceil(count/64) groups along X.
  const uint at = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
  if(push.phase == 0u) {
    if(at < push.clusterCount)
      history[at] = uvec2(0u, clusters[at].historyGeneration);
    return;
    }

  if(at < push.clusterCount)
    status[at] = 0u;
  if(at < 5u)
    stats[at] = 0u;
  }
