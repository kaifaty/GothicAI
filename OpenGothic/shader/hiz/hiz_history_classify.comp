#version 450

#extension GL_GOOGLE_include_directive : enable

#include "common.glsl"
#include "scene.glsl"
#include "materials/tree_hiz_bounds.glsl"

layout(local_size_x = 64) in;

layout(binding = 0, std140) uniform UboScene { SceneDesc scene; };
layout(binding = 1, std430) readonly buffer Clusters { Cluster clusters[]; };
layout(binding = 2, std430) readonly buffer Instances { uint instanceMem[]; };
layout(binding = 3, std140) readonly buffer Buckets { Bucket buckets[]; };
layout(binding = 4, std430) readonly buffer Previous { uvec2 previous[]; };
layout(binding = 5) uniform sampler2D historyHiZ;
layout(binding = 6, std430) buffer Status { uint status[]; };
layout(binding = 7, std430) buffer Stats { uint stats[]; };

layout(push_constant, std430) uniform Push {
  uint clusterCount;
  float znear;
  float depthRoundoff;
  uint phase;
  uint threshold;
  uint statsEnabled;
  uint previousCount;
  uint pad1;
  } push;

const uint Submitted = 1u;
const uint Early = 2u;
const uint Tested = 4u;
const uint Rejected = 8u;
const uint Canopy = 16u;
const uint Eligible = 32u;
#if defined(TREE_BOUGH_LOD)
const uint Bough = 64u;
#endif
const float Epsilon = 1.1920928955078125e-7;

bool finiteValues(vec4 value) {
  // Test exponent bits; some shader backends compile with finite math assumptions.
  return all(notEqual(floatBitsToUint(value) & 0x7f800000u, uvec4(0x7f800000u)));
  }

mat4x3 treeTransform(uint slot) {
  uint at = slot * 16u;
  return mat4x3(
      uintBitsToFloat(uvec3(instanceMem[at + 0u], instanceMem[at + 1u], instanceMem[at + 2u])),
      uintBitsToFloat(uvec3(instanceMem[at + 3u], instanceMem[at + 4u], instanceMem[at + 5u])),
      uintBitsToFloat(uvec3(instanceMem[at + 6u], instanceMem[at + 7u], instanceMem[at + 8u])),
      uintBitsToFloat(uvec3(instanceMem[at + 9u], instanceMem[at + 10u], instanceMem[at + 11u])));
  }

bool projectBox(Cluster cluster, Bucket bucket,
#if defined(TREE_BOUGH_LOD)
                bool bough,
#endif
                out vec4 rect, out float nearDepth) {
  if(cluster.instanceId == 0xffffffffu ||
#if defined(TREE_BOUGH_LOD)
     (!bough && bucket.treeHiZCount == 0u) ||
#else
     bucket.treeHiZCount == 0u ||
#endif
     (bucket.flags & (BK_SKIN | BK_MORPH | BK_STRAND)) != 0u)
    return false;

  const uint base = cluster.instanceId * 16u;
  if(instanceMem[base + 15u] != 0u || uintBitsToFloat(instanceMem[base + 12u]) != 0.0)
    return false;

  const mat4x3 object = treeTransform(cluster.instanceId);
  vec3 low, high;
#if defined(TREE_BOUGH_LOD)
  if(bough) {
    low = bucket.bbox[0].xyz;
    high = bucket.bbox[1].xyz;
    } else
#endif
  if(!treeHiZBox(cluster, bucket, object, scene.camPos, scene.foliageFade.x, low, high))
    return false;
  if(!finiteValues(vec4(low, 0.0)) || !finiteValues(vec4(high, 0.0)) || any(greaterThan(low, high)))
    return false;

  // Pad the authored extent and wind arithmetic before either affine transform.
  // Each term in a four-term dot product is rounded at most four times.
  // Budget both affine transforms, their corner evaluation and a separately
  // evaluated vertex, with slack for the padding arithmetic itself.
  vec3 localMagnitude = max(abs(low), abs(high));
  vec3 localPad = (localMagnitude + abs(bucket.foliageReach) + 1.0) * (64.0 * Epsilon);
  low -= localPad;
  high += localPad;
  localMagnitude = max(abs(low), abs(high));
  const vec3 worldMagnitude = abs(object[0]) * localMagnitude.x +
                              abs(object[1]) * localMagnitude.y +
                              abs(object[2]) * localMagnitude.z + abs(object[3]);
  const mat4 project = scene.viewProject;
  const vec4 clipWorldMagnitude = abs(project[0]) * worldMagnitude.x +
                                  abs(project[1]) * worldMagnitude.y +
                                  abs(project[2]) * worldMagnitude.z;
  const vec4 clipError = (clipWorldMagnitude + abs(project[3]) + 1.0) * (16.0 * Epsilon);

  rect = vec4(1.0, 1.0, -1.0, -1.0);
  nearDepth = 1.0;
  for(uint i = 0u; i < 8u; ++i) {
    const vec3 local = vec3((i & 1u) != 0u ? high.x : low.x,
                            (i & 2u) != 0u ? high.y : low.y,
                            (i & 4u) != 0u ? high.z : low.z);
    const vec4 clip = project * vec4(object * vec4(local, 1.0), 1.0);
    const vec4 clipLo = clip - clipError;
    const vec4 clipHi = clip + clipError;
    if(!finiteValues(clipLo) || !finiteValues(clipHi) || clipLo.w <= push.znear || clipLo.z <= 0.0)
      return false;
    const vec3 lower = min(clipLo.xyz / clipLo.w, clipLo.xyz / clipHi.w);
    const vec3 upper = max(clipHi.xyz / clipLo.w, clipHi.xyz / clipHi.w);
    rect = vec4(min(rect.xy, lower.xy), max(rect.zw, upper.xy));
    nearDepth = min(nearDepth, lower.z);
    }

  nearDepth -= push.depthRoundoff + 8.0 * Epsilon;
  return nearDepth > 0.0 && finiteValues(rect);
  }

int roundedPowerOfTwo(int size) {
  return 1 << (findMSB(uint(size - 1)) + 1);
  }

bool fullyHidden(vec4 rect, float nearDepth) {
  const ivec2 base = textureSize(historyHiZ, 0);
  const ivec2 tile = ivec2(roundedPowerOfTwo(scene.screenRes.x), roundedPowerOfTwo(scene.screenRes.y)) / base;

  // Include cells touching the upper edge and extend by a pixel for rasterization
  // and projected-coordinate rounding. Clear pixels within these cells keep depth 1.
  const vec4 pixels = (clamp(rect, -2.0, 2.0) * 0.5 + 0.5) * vec2(scene.screenRes).xyxy;
  const vec2 last = vec2(scene.screenRes - 1);
  ivec2 low = ivec2(clamp(pixels.xy - 1.0, vec2(0.0), last)) / tile;
  ivec2 high = ivec2(clamp(pixels.zw + 1.0, vec2(0.0), last)) / tile;
  int mip = 0;
  while(any(greaterThan(high - low, ivec2(7)))) {
    low >>= 1;
    high >>= 1;
    ++mip;
    }

  for(int y = low.y; y <= high.y; ++y) {
    for(int x = low.x; x <= high.x; ++x) {
      if(!(nearDepth > texelFetch(historyHiZ, ivec2(x, y), mip).r))
        return false;
      }
    }
  return true;
  }

void main() {
  const uint id = gl_GlobalInvocationID.x;
  if(id >= push.clusterCount || (status[id] & Submitted) == 0u)
    return;

  const Cluster cluster = clusters[id];
  const Bucket bucket = buckets[cluster.bucketId_commandId >> 16u];
  if(push.phase == 0u) {
    uint flags = status[id];
    if((bucket.flags & BK_CANOPY) != 0u)
      flags |= Canopy;
    if(
#if defined(TREE_BOUGH_LOD)
       (flags & Bough) == 0u &&
#endif
       id < push.previousCount && previous[id].x >= push.threshold &&
       previous[id].y == cluster.historyGeneration) {
      flags |= Early;
      if(push.statsEnabled != 0u) {
        atomicAdd(stats[0], 1u);
        atomicAdd(stats[1], uint(cluster.meshletCount));
        }
      }
    status[id] = flags;
    return;
    }

  if((status[id] & (Early | Eligible)) != Eligible)
    return;
  vec4 rect;
  float nearDepth;
  if(!projectBox(cluster, bucket,
#if defined(TREE_BOUGH_LOD)
                 (status[id] & Bough) != 0u,
#endif
                 rect, nearDepth))
    return;

  const bool hidden = fullyHidden(rect, nearDepth);
  status[id] |= Tested | (hidden ? Rejected : 0u);
  if(push.statsEnabled != 0u) {
    atomicAdd(stats[2], 1u);
    if(hidden) {
      atomicAdd(stats[3], 1u);
      atomicAdd(stats[4], uint(cluster.meshletCount));
      }
    }
  }
