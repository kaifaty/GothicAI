#version 450

#extension GL_ARB_separate_shader_objects : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_control_flow_attributes : enable

#include "scene.glsl"
#include "common.glsl"
#include "virtual_shadow/vsm_common.glsl"
#include "virtual_shadow/vsm_cull.glsl"

// The meshlets of the candidates of vsm_visibility_pass.comp, a workgroup to a candidate at a time. An object's cluster
// (an instance of a static mesh, neither deformed nor morphed) keeps the meshlets whose own spheres
// (Bucket::meshletSpheres) touch the candidate's page entry; before, a spruce went with all its 724 meshlets into every
// page its sphere touched (reports/engine/2026-11-16-modern-trees/shadow-flicker.md, «Второй круг»). Any other
// cluster is taken whole.
// Pass 0 counts the meshlets of each candidate and the pairs of each class; pass 1 lets in the classes of vsmAdmit
// and writes their pairs. One pipeline for both, so the two passes count the same meshlets.
layout(local_size_x = 64) in;

layout(push_constant, std430) uniform UboPush {
  uint pairCap;  // DrawCommands::vsmPairCap: of the pairs and of the candidates
  uint emit;     // 0: count, 1: write
  } push;
layout(binding = 0, std140) uniform UboScene     { SceneDesc   scene;         };
layout(binding = 1, std430) buffer Cnd           { uvec4       candidates[];  };
layout(binding = 2, std430) readonly buffer Mem  { uint        instanceMem[]; };
layout(binding = 3, std140) readonly buffer Bbo  { Bucket      bucket[];      };
layout(binding = 4, std430) buffer IndirectBuf   { IndirectCmd cmd[];         };
layout(binding = 5, std430) readonly buffer Cbo  { Cluster     clusters[];    };
layout(binding = 6, std430) readonly buffer Lbo  { LightSource lights[];      };
layout(binding = 7, std430) readonly buffer Sph  { vec4        spheres[];     }; // DrawBuckets::meshletSpheres
layout(binding = 8, std430) buffer Pages         { VsmHeader   header; uint  pageList[]; } vsm;
layout(binding = 9, std430) writeonly buffer Pld { uvec4       payload[];     };

shared uint sAdmit; // the classes drawn this frame
shared uint sBase;  // the first slot of the candidate's pairs
shared uint sPass;  // its meshlets found so far

Instance pullInstance(uint i) {
  i *= 16;
  Instance ret;
  ret.mat[0][0] = uintBitsToFloat(instanceMem[i+0]);
  ret.mat[0][1] = uintBitsToFloat(instanceMem[i+1]);
  ret.mat[0][2] = uintBitsToFloat(instanceMem[i+2]);
  ret.mat[1][0] = uintBitsToFloat(instanceMem[i+3]);
  ret.mat[1][1] = uintBitsToFloat(instanceMem[i+4]);
  ret.mat[1][2] = uintBitsToFloat(instanceMem[i+5]);
  ret.mat[2][0] = uintBitsToFloat(instanceMem[i+6]);
  ret.mat[2][1] = uintBitsToFloat(instanceMem[i+7]);
  ret.mat[2][2] = uintBitsToFloat(instanceMem[i+8]);
  ret.mat[3][0] = uintBitsToFloat(instanceMem[i+9]);
  ret.mat[3][1] = uintBitsToFloat(instanceMem[i+10]);
  ret.mat[3][2] = uintBitsToFloat(instanceMem[i+11]);
  ret.fatness   = uintBitsToFloat(instanceMem[i+12]);
  ret.animPtr   = instanceMem[i+13];
  ret.deformPtr = instanceMem[i+14];
  ret.deformCount = instanceMem[i+15];
  return ret;
  }

// the meshlets of a cluster that cast a shadow: of strands, the first part of the list
int shadowMeshlets(const Cluster cluster) {
  if(cluster.instanceId!=0xFFFFFFFF && (bucket[cluster.bucketId_commandId >> 16].flags & BK_STRAND)!=0u)
    return strandShadowMeshlets(cluster.meshletCount, pullInstance(cluster.instanceId).fatness);
  return cluster.meshletCount;
  }

// A meshlet's sphere in the mesh, in the world by the instance: the radius grows by the scale and by what moves the
// vertices off the mesh in the shadow pass - the wind of a tree and a material's wave (the cluster's sphere holds
// them over the mesh's: VisualObjects, DrawClusters) and the fatness
bool meshletInEntry(const vec4 local, const Instance obj, const float scale, const float pad, const uint data) {
  const vec4 sphere = vec4(obj.mat*vec4(local.xyz, 1.0), (local.w + pad)*scale);
  if(vsmPageIsOmni(data)) {
    const uvec2 light = unpackLightId(data);
    return vsmOmniFaceTest(sphere, lights[light.x].pos, lights[light.x].range, light.y);
    }
  vec4  aabb     = vec4(0);
  float depthMax = 0;
  if(!vsmProjectSphere(scene.viewProject, sphere, aabb, depthMax))
    return false;
  const ivec3 page = unpackVsmPageInfo(data);
  return vsmEntryOverlap(vsmPageTableBox(aabb, uint(page.z)), page, unpackVsmPageSize(data));
  }

void cullCandidate(const uint c) {
  const uvec4   cand    = candidates[c];
  const Cluster cluster = clusters[cand.x];
  const uint    entry   = cand.y & 0xFFFFu;
  const uint    cls     = cand.y >> 16;
  const uint    lane    = gl_LocalInvocationIndex;
  const bool    emit    = push.emit!=0u;

  if(emit && ((sAdmit & (1u << cls))==0u || cand.z==0u))
    return; // the same for the whole workgroup
  if(lane==0) {
    sPass = 0;
    if(emit) {
      sBase = atomicAdd(vsm.header.meshletCount, cand.z);
      atomicAdd(cmd[cluster.bucketId_commandId & 0xFFFF].instanceCount, cand.z);
      }
    }
  barrier();

  const uint bId     = cluster.bucketId_commandId >> 16;
  uint       first   = VSM_NO_SPHERES;
  Instance   obj;
  float      scale   = 1;
  float      pad     = 0;
  if(cluster.instanceId!=0xFFFFFFFF && bucket[bId].meshletSpheres!=VSM_NO_SPHERES &&
     (bucket[bId].flags & (BK_SKIN | BK_MORPH | BK_STRAND))==0u) {
    obj = pullInstance(cluster.instanceId);
    if(obj.deformCount==0u) {
      first = bucket[bId].meshletSpheres + cluster.firstMeshlet;
      scale = sqrt(max(max(dot(obj.mat[0], obj.mat[0]), dot(obj.mat[1], obj.mat[1])), dot(obj.mat[2], obj.mat[2])));
      pad   = max(cluster.sphere.w - bucket[bId].bboxRadius, 0.0) + abs(obj.fatness);
      }
    }

  const int  count = shadowMeshlets(cluster);
  const uint data  = vsm.pageList[entry];
  for(int i=int(lane); i<count; i+=int(gl_WorkGroupSize.x)) {
    if(first!=VSM_NO_SPHERES && !meshletInEntry(spheres[first + uint(i)], obj, scale, pad, data))
      continue;
    const uint at = atomicAdd(sPass, 1);
    if(emit && at<cand.z)
      payload[sBase + at] = uvec4(cluster.instanceId, cluster.firstMeshlet + uint(i), cluster.bucketId_commandId, entry);
    }
  barrier();

  if(emit) {
    // never: the count found these meshlets in the same pipeline. A slot left must not keep an older frame's pair
    for(uint at=sPass+lane; at<cand.z; at+=gl_WorkGroupSize.x)
      payload[sBase + at] = uvec4(VSM_PAIR_SKIP);
    }
  else if(lane==0) {
    candidates[c].z = sPass;
    atomicAdd(vsm.header.pairDemand[cls], sPass);
    atomicAdd(vsm.header.clusterPairs, uint(count));
    }
  barrier();
  }

void main() {
  if(push.emit!=0u && gl_LocalInvocationIndex==0) {
    uint demand[VSM_PAIR_CLASSES];
    for(int i=0; i<VSM_PAIR_CLASSES; ++i)
      demand[i] = vsm.header.pairDemand[i];
    sAdmit = vsmAdmit(demand, push.pairCap, vsm.header.admitPrev);
    if(gl_WorkGroupID.x==0)
      vsm.header.admitMask = sAdmit;
    }
  barrier();

  const uint count = min(vsm.header.candidateCount, push.pairCap);
  for(uint c=gl_WorkGroupID.x; c<count; c+=gl_NumWorkGroups.x)
    cullCandidate(c);
  }
