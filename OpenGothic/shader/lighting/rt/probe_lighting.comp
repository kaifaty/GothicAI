#version 460

#extension GL_EXT_control_flow_attributes : enable
#extension GL_GOOGLE_include_directive    : enable

#define RAY_QUERY
#define RAY_QUERY_AT

#include "lighting/rt/rt_common.glsl"
#include "lighting/rt/probe_common.glsl"
#include "lighting/lightstree/lights_common.glsl"
#include "lighting/tonemapping.glsl"
#include "scene.glsl"
#include "common.glsl"
#include "random.glsl"

// Light at the points the rays of a probe hit (gbuffer of probe_trace.comp), as the path tracer lights a hit
// (lighting/pt/pathtrace.frag): the sun and the lamps of the lights tree with a shadow ray, the sky on a miss, and
// the bounce off the probes themselves from the last frame instead of the path's next bounces.
// RELIGHT (probe_relight.comp): a thread relights one sample of an old probe, each sample once in relitPeriod
// frames, into its radiance in probesRadiance. Otherwise (probe_lighting.comp) a workgroup integrates a probe's
// 256 samples into its ambient cube, blended over time with the last frame's cube (reset on a sharp change, as in
// DDGI); a new probe has no radiance yet, it lights all its samples here.

layout(primitive_culling);
layout(local_size_x = 64) in;

const uint  samplesCount = 4;
const uint  samplesTotal = 256;
const uint  NoSample     = 0xFFFFFFFFu;  // probesRadiance: the sample does not count (a ray down into the void)
const float TMax         = 500*100;      // the shadow rays of the path tracer
const vec3  NightSky     = vec3(0.3, 0.26, 1)*0.15; // pathtrace.frag: added to the sky of a miss
// a change of the cube over this (relative, by luminance) drops its history
const float ResetChange  = 0.33;

layout(push_constant, std140) uniform Push {
  float alpha;       // weight of the new estimate in the blend with the last frame, from dt
  uint  frameId;
  uint  relitPeriod; // an old probe's sample is relit once in so many frames
  };

layout(binding = 0, std140) readonly buffer UboScene { // ubo is broken on NVidia?
  SceneDesc scene;
  };
layout(binding = 1) uniform writeonly image2D probesLighting;
layout(binding = 2) uniform sampler2D gbufferDiff;
layout(binding = 3) uniform sampler2D gbufferNorm;
layout(binding = 4) uniform sampler2D gbufferRayT;
layout(binding = 5) uniform sampler2D skyLUT;
// 6..11: the ray scene, rt_common.glsl
layout(binding = 12) uniform sampler2D probesLightingPrev;
layout(binding = 13, std430) readonly buffer Hbo { uint hashTable[]; };
layout(binding = 14, std430) buffer Pbo { ProbesHeader probeHeader; Probe probe[]; };
layout(binding = 15, std430) readonly buffer BVH { PTreeNode node[]; } lightsTree;
layout(binding = 16, r32ui) uniform restrict uimage2D probesRadiance;

#if !defined(RELIGHT)
shared vec4 samples[gl_WorkGroupSize.x][3][2]; // 6 Kb
#if defined(MATERIAL_MAPS)
// Keep sky visibility separate from the counts used by the RGB integration.
shared vec2 skySamples[gl_WorkGroupSize.x][3][2];
#endif
shared uint shProbeId;
#endif

float luma(vec3 c) {
  return dot(c, vec3(0.2126, 0.7152, 0.0722));
  }

bool planetOcclusion(float y, vec3 sunDir) {
  // lighting/direct_light.frag: the sun under the horizon
  const float h = RPlanet + max(y*0.1, 0);
  return rayIntersect(vec3(0,h,0), sunDir, RPlanet)>=0;
  }

float shadowRay(vec3 origin, vec3 dir, float tMax) {
  // the shadow ray of the path tracer (pathtrace_common.glsl): shadow casters, alpha test, front faces
  rayQueryEXT rayQuery;
  rayQueryInitializeEXT(rayQuery, topLevelAS, RayFlagsShadow, CM_ShadowCaster, origin, 1.0, dir, tMax);
  rayQueryProceedShadow(rayQuery);
  if(rayQueryGetIntersectionTypeEXT(rayQuery, true) == gl_RayQueryCommittedIntersectionNoneEXT)
    return 1;
  return 0;
  }

float sunLight(vec3 norm, vec3 pos) {
  // pathtrace.frag, sampleDirectLight
  const float lamb = max(dot(norm, scene.sunDir), 0);
  if(lamb<=0 || planetOcclusion(pos.y, scene.sunDir))
    return 0;
  return lamb * shadowRay(pos, scene.sunDir, TMax);
  }

float pointLight(vec3 norm, vec3 pos, vec3 lightPos, float range) {
  // pathtrace.frag, samplePointLight
  const vec3  ldir      = lightPos - pos;
  const float dist      = length(ldir);
  const vec3  dir       = ldir/max(dist, 0.001);
  const float intensity = lightIntensity(norm, dist, -dir, range);
  if(intensity<=0)
    return 0;
  const float rayDistance = dist - range*0.0375; // padding of the path tracer, a light may stand in a wall
  if(rayDistance<=0)
    return intensity;
  return intensity * shadowRay(pos, dir, rayDistance);
  }

vec3 localLight(vec3 norm, vec3 pos, float key) {
  // pathtrace.frag, sampleLocalLight: one lamp by the weights of the tree, divided by its probability
  float pdf  = 1.0;
  uint  node = 0 | BVH_BoxNode;
  [[loop]]
  for(int depth=0; depth<64; ++depth) {
    const uint type = bvhGetNodeType(node);
    if(type==BVH_LightNode)
      break;
    if(type!=BVH_BoxNode)
      return vec3(0);
    const PTreeNode n      = lightsTree.node[node & 0x0FFFFFFF];
    const float     wLeft  = bvhLightsNodeWeight(pos, norm, n.centerL, n.weightL);
    const float     wRight = bvhLightsNodeWeight(pos, norm, n.centerR, n.weightR);
    const float     pLeft  = wLeft /(wLeft + wRight);
    const float     pRight = wRight/(wLeft + wRight);
    if(key < pLeft) {
      pdf *= pLeft;
      node = n.ptrL;
      key  = key/pLeft;
      } else {
      pdf *= pRight;
      node = n.ptrR;
      key  = (key-pLeft)/pRight;
      }
    }
  if(bvhGetNodeType(node)!=BVH_LightNode)
    return vec3(0);

  const PTreeNode n = lightsTree.node[node & 0x0FFFFFFF];
  if(pdf < 0.001)
    return vec3(0); // numerically unstable + fireflys, as in the path tracer
  const float intensity = pointLight(norm, pos, n.centerL, n.weightR);
  return (intensity * n.centerR) / pdf;
  }

vec3 skyRadiance(vec3 origin, vec3 dir) {
  // the sky of a miss in the path tracer
  vec3 sky = textureSkyLUT(skyLUT, vec3(0,RPlanet+max(origin.y*0.01,0),0), dir, scene.sunDir) * scene.GSunIntensity;
  return sky + NightSky;
  }

vec3 readSelf(uint probeId, bool hasPrev, vec3 n) {
  // the probe's own light of the last frame in the hit's direction; a new probe has none
  return hasPrev ? probeReadAmbient(probesLightingPrev, probeId, n, vec3(0)) : vec3(0);
  }

bool findProbe(vec3 pos, vec3 norm, out uint id) {
  // the probe of the last frame at a hit the camera sees: the lod and the cage of probe_allocation.comp there
  const vec4 clip = scene.viewProject*vec4(pos,1);
  if(clip.w<=0)
    return false;
  const vec3 ndc = clip.xyz/clip.w;
  if(any(greaterThanEqual(abs(ndc.xy), vec2(1))) || ndc.z<0 || ndc.z>=SKY_DEPTH)
    return false;

  const ivec2 screenSize = scene.screenRes;
  const ivec2 fragCoord  = clamp(ivec2((ndc.xy*0.5+0.5)*vec2(screenSize)), ivec2(0), screenSize-1);
  const int   lod        = probeGridComputeLod(fragCoord, screenSize, ndc.z, scene.viewProjectInv, scene.probeGridBias);
  const float step       = probeGridStep*(1 << lod);

  // the corner of the cage furthest along the normal: allocation keeps the corners on the normal's side
  const ivec3 px   = ivec3(round((pos + norm*(probeCageBias + 0.5*step))/step));
  const vec3  wpos = vec3(px)*step;
  if(dot(wpos - pos, norm)<0)
    return false;

  const ivec3 gridPos = px*(1 << lod);
  uint probeId = hashTable[probeGridPosHash(gridPos) % hashTable.length()];
  [[loop]]
  for(int i=0; i<8; ++i) {
    if(probeId>=probeHeader.count)
      return false;
    const Probe p = probe[probeId];
    if((p.bits & TRACED_BIT)!=0 && probeIsSame(p.pos, wpos, lod)) {
      // a new probe has no light of the last frame yet; a bad one sits in a wall
      if((p.bits & (NEW_BIT | BAD_BIT | UNUSED_BIT))!=0)
        return false;
      id = probeId;
      return true;
      }
    probeId = p.pNext;
    }
  return false;
  }

vec3 bounce(vec3 pos, vec3 norm, uint probeId, bool hasPrev) {
  // The light of the hit's own surroundings: the probe there, else this probe's own in the hit's direction.
  // One more ray from the hit instead changed the hut at noon by 1 % and cost as much as the rest of the lighting.
  uint id = 0;
  if(findProbe(pos, norm, id))
    return probeReadAmbient(probesLightingPrev, id, norm, vec3(0));
  return readSelf(probeId, hasPrev, norm);
  }

vec4 shadeSample(const vec3 rayOrigin, const vec3 rayDirection, uint probeId, uint sampleId, bool hasPrev) {
  const ivec2 uv     = gbufferCoord(probeId, sampleId);
  const vec4  diff   = texelFetch(gbufferDiff, uv, 0);
  const uint  bits   = uint(diff.a*255.0+0.5);
  const bool  sky    = (bits & 0x4)!=0;
  const bool  badbit = (bits & 0x2)!=0;

  if(sky)
    return vec4(skyRadiance(rayOrigin, rayDirection), badbit ? 0 : 1);

  const vec4  nr     = texelFetch(gbufferNorm, uv, 0);
  const float rt     = texelFetch(gbufferRayT, uv, 0).r;
  const float rayT   = rt * probeRayDistance;
  const vec3  pos    = rayOrigin + rayT*rayDirection;

  vec3 norm = normalize(nr.xyz*2.0-vec3(1));
  if(dot(norm, rayDirection)>0)
    norm = -norm; // backfaces are fine for the path tracer: they face the probe
  const vec3 albedo = min(textureAlbedo(diff.rgb), vec3(0.95));
  const vec3 at     = pos + norm*0.5; // the hit distance is 16-bit: off the surface for the shadow rays

  // A lamp per sample; the key goes through the samples of the probe as a low-discrepancy sequence (golden-ratio
  // steps in 32-bit fixed point). It stays the same from frame to frame and for a probe made again at the same
  // place: a new choice at every relight flickered (the cube's change passed the reset). The light still follows
  // the lamps, the sun and the time of day; the choice only spreads the error over the probes.
  const uint  seed = probeGridPosHash(ivec3(round(rayOrigin/probeGridStep)));
  const uint  k    = sampleId*2654435769u + seed*2447445413u;
  const float key  = float(k >> 8) * (1.0/16777216.0);

  vec3 direct = vec3(0);
  direct += sunLight(norm, at) * scene.sunColor;
  direct += localLight(norm, at, key) * (max(1.0, scene.exposure) / scene.exposure);

  vec3 hit = albedo * direct * Fd_Lambert;
  hit += albedo * bounce(pos, norm, probeId, hasPrev); // Fd_Lambert is in the probes' integration
  return vec4(hit, 1);
  }

#if defined(RELIGHT)
void main() {
  const uint perProbe = samplesTotal/relitPeriod;
  const uint probeId  = gl_GlobalInvocationID.x/perProbe;
  if(probeId>=probeHeader.count)
    return;
  const uint bits = probe[probeId].bits;
  if((bits & (UNUSED_BIT | NEW_BIT))!=0 || (bits & TRACED_BIT)==0)
    return; // a new probe lights all its samples in probe_lighting.comp

  const uint sampleId = (gl_GlobalInvocationID.x%perProbe)*relitPeriod + (frameId + probeId)%relitPeriod;
  const vec3 dir      = sampleSphere(sampleId, samplesTotal, 0);
  const vec4 clr      = shadeSample(probe[probeId].pos, dir, probeId, sampleId, true);
  imageStore(probesRadiance, gbufferCoord(probeId, sampleId), uvec4(clr.a>0 ? packRGB9E5(clr.rgb) : NoSample));
  }
#else
void storeSample(vec3 dir, vec4 val) {
  if(val.a==0)
    return;

  for(int i=0; i<3; ++i) {
    float v = dir[i];
    int   d = v>=0 ? 1 : 0;
    v = abs(v);
    samples[gl_LocalInvocationIndex][i][d] += vec4(val.rgb*v, 1);
    }
  }

#if defined(MATERIAL_MAPS)
void storeSkySample(vec3 dir, float valid, bool sky) {
  if(valid==0)
    return;

  for(int i=0; i<3; ++i) {
    const int d = dir[i]>=0 ? 1 : 0;
    const float weight = abs(dir[i]);
    skySamples[gl_LocalInvocationIndex][i][d] += vec2(sky ? weight : 0.0, weight);
    }
  }

float resolveSkyVisibility(vec2 sampleWeights) {
  return sampleWeights.y>0.0 ? clamp(sampleWeights.x/sampleWeights.y, 0.0, 1.0) : 0.0;
  }
#endif

void processLighting(const uint probeId, const bool fresh) {
  const vec3 origin = probe[probeId].pos;

  for(uint i=0; i<samplesCount; ++i) {
    const uint  sampleId = gl_LocalInvocationIndex*samplesCount+i;
    const vec3  dir      = sampleSphere(sampleId, samplesTotal, 0);
    const ivec2 uv       = gbufferCoord(probeId, sampleId);

    vec4 clr = vec4(0);
    if(fresh) {
      clr = shadeSample(origin, dir, probeId, sampleId, false);
      imageStore(probesRadiance, uv, uvec4(clr.a>0 ? packRGB9E5(clr.rgb) : NoSample));
      } else {
      const uint v = imageLoad(probesRadiance, uv).r;
      if(v!=NoSample)
        clr = vec4(unpackRGB9E5(v), 1);
      }
    storeSample(dir, clr);
#if defined(MATERIAL_MAPS)
    if(fresh) {
      // the sky visibility depends on the trace only: a new probe counts it
      const uint bits = uint(texelFetch(gbufferDiff, uv, 0).a*255.0+0.5);
      storeSkySample(dir, clr.a, (bits & 0x4)!=0);
      }
#endif
    }
  }

void processProbe(const uint probeId) {
  const uint laneId = gl_LocalInvocationIndex;
  const uint bits   = probe[probeId].bits;

  if((bits & UNUSED_BIT)!=0)
    return;
  // a new probe or a slot taken again: no history, all samples now
  const bool fresh = (bits & NEW_BIT)!=0 || (bits & TRACED_BIT)==0;

  for(int i=0; i<3; ++i) {
    samples[laneId][i][0] = vec4(0);
    samples[laneId][i][1] = vec4(0);
#if defined(MATERIAL_MAPS)
    skySamples[laneId][i][0] = vec2(0);
    skySamples[laneId][i][1] = vec2(0);
#endif
    }
  barrier();

  processLighting(probeId, fresh);
  barrier();

  for(uint i=gl_WorkGroupSize.x; i>0;) {
    i /= 2;
    if(laneId<i) {
      for(int r=0; r<3; ++r) {
        samples[laneId][r][0] += samples[laneId+i][r][0];
        samples[laneId][r][1] += samples[laneId+i][r][1];
#if defined(MATERIAL_MAPS)
        skySamples[laneId][r][0] += skySamples[laneId+i][r][0];
        skySamples[laneId][r][1] += skySamples[laneId+i][r][1];
#endif
        }
      }
    barrier();
    }

#if defined(MATERIAL_MAPS)
  if(laneId==0 && fresh) {
    vec3 negativeVisibility, positiveVisibility;
    for(int axis=0; axis<3; ++axis) {
      negativeVisibility[axis] = resolveSkyVisibility(skySamples[0][axis][0]);
      positiveVisibility[axis] = resolveSkyVisibility(skySamples[0][axis][1]);
      }
    probe[probeId].bits = probePackSkyVisibility(probe[probeId].bits, negativeVisibility, positiveVisibility);
    }
#endif

  if(laneId<6) {
    const uint axis = laneId/2;
    const uint side = laneId%2;
    vec4 s = samples[0][axis][side];
    // Need to mul by 2, because it's uniform sampling; https://www.rorydriscoll.com/2009/01/07/better-sampling/
    const vec3 est = (s.w>0 ? s.rgb/s.w : vec3(0)) * 2.0;

    vec3 ret = est;
    if(!fresh) {
      const vec3  hist   = texelFetch(probesLightingPrev, lightBufferCoord(probeId)+ivec2(axis,side), 0).rgb;
      const float lh     = luma(hist);
      const float ln     = luma(est);
      const float eps    = 0.0005/max(scene.exposure, 1e-6); // dark on the screen: no reset on noise there
      const float change = abs(ln-lh)/max(max(ln, lh), eps);
      ret = mix(hist, est, change>ResetChange ? 1.0 : alpha);
      }
    const ivec2 uv = lightBufferCoord(probeId);
    imageStore(probesLighting, uv+ivec2(axis,side), vec4(ret, 1));
    }
  }

void main() {
  while(true) {
    if(gl_LocalInvocationIndex==0)
      shProbeId = atomicAdd(probeHeader.iterator2, 1);
    barrier();
    const uint probeId = shProbeId;
    if(probeId>=probeHeader.count)
      return;
    processProbe(probeId);
    barrier();
    }
  }
#endif
